{
  "version": "1.2",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "astro",
  "default_branch": "main",
  "frontmatter_format": "yaml",
  "sitemap_url": "https://gitcms.dev/sitemap.xml",
  "publishing_mode": "editorial_workflow",
  "i18n": {
    "enabled": true,
    "locales": [
      "en"
    ],
    "default_locale": "en",
    "prefix_default_locale": false
  },
  "collections": [
    {
      "name": "docs",
      "git_path": "/content/docs/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "grouped",
      "i18n": {
        "enabled": true,
        "strategy": "path"
      },
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        }
      ]
    },
    {
      "name": "comparisons",
      "git_path": "/content/comparisons/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "i18n": {
        "enabled": true,
        "strategy": "path"
      },
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        },
        {
          "name": "competitor",
          "type": "text",
          "label": "Competitor"
        },
        {
          "name": "category",
          "type": "text",
          "label": "Category"
        },
        {
          "name": "lastReviewed",
          "type": "datetime",
          "label": "Last Reviewed"
        },
        {
          "name": "order",
          "type": "number",
          "label": "Order"
        }
      ]
    },
    {
      "name": "glossary",
      "git_path": "/content/glossary/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "category",
          "type": "select",
          "label": "Category",
          "options": [
            "building",
            "rendering",
            "content",
            "git",
            "cms",
            "agents",
            "seo",
            "deploy",
            "operations"
          ],
          "color": "purple"
        },
        {
          "name": "definition",
          "type": "text",
          "label": "Definition"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        },
        {
          "name": "related",
          "type": "multiselect",
          "label": "Related terms",
          "allowCustom": true,
          "color": "blue"
        },
        {
          "name": "lastReviewed",
          "type": "datetime",
          "label": "Last Reviewed"
        }
      ]
    },
    {
      "name": "prompts",
      "git_path": "/content/prompts/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        },
        {
          "name": "category",
          "type": "select",
          "label": "Category",
          "options": [
            "handoff",
            "content",
            "seo",
            "migration"
          ],
          "color": "purple"
        },
        {
          "name": "agents",
          "type": "multiselect",
          "label": "Agents",
          "allowCustom": true,
          "color": "blue"
        },
        {
          "name": "order",
          "type": "number",
          "label": "Order"
        },
        {
          "name": "lastReviewed",
          "type": "datetime",
          "label": "Last Reviewed"
        }
      ]
    },
    {
      "name": "tools",
      "git_path": "/content/tools/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        },
        {
          "name": "tool",
          "type": "select",
          "label": "Tool",
          "options": [
            "markdown-editor",
            "agents-md-editor",
            "claude-md-editor",
            "image-compressor",
            "github-repo"
          ],
          "color": "purple"
        },
        {
          "name": "order",
          "type": "number",
          "label": "Order"
        }
      ]
    },
    {
      "name": "changelogs",
      "git_path": "/content/changelog/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "version",
          "type": "text",
          "label": "Version"
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        }
      ]
    },
    {
      "name": "pages",
      "git_path": "/content/pages/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        }
      ]
    },
    {
      "name": "blogs",
      "git_path": "/content/blog/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date"
        },
        {
          "name": "category",
          "type": "text",
          "label": "Category"
        },
        {
          "name": "authors",
          "type": "multiselect",
          "label": "Authors",
          "options": [
            "Waishnav"
          ],
          "color": "blue"
        }
      ]
    }
  ]
}
