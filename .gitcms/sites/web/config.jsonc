{
  "version": "1.4",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "astro",
  "default_branch": "main",
  "frontmatter_format": "yaml",
  "sitemap_url": "https://gitcms.dev/sitemap.xml",
  "publishing_mode": "editorial_workflow",
  "i18n": {
    "enabled": true,
    "locales": [
      "en"
    ],
    "default_locale": "en",
    "prefix_default_locale": false
  },
  "collections": [
    "docs",
    "comparisons",
    "alternatives",
    "glossary",
    "prompts",
    "tools",
    "changelogs",
    "pages",
    "blogs"
  ]
}
