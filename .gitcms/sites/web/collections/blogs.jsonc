{
  "git_path": "/content/blog/",
  "file_extension": ".mdx",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title"
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description"
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date"
    },
    {
      "name": "category",
      "type": "text",
      "label": "Category"
    },
    {
      "name": "authors",
      "type": "multiselect",
      "label": "Authors",
      "options": [
        "Waishnav"
      ],
      "color": "blue"
    }
  ]
}
