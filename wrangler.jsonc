{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitcms-site",
  "routes": [
    {
      "pattern": "gitcms.dev",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2025-09-02",
  // Workers Builds runs `wrangler preview` for non-main branches, which requires this
  // block. The site has no bindings beyond assets, so previews need no overrides.
  "previews": {},
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Pages go through the worker for `Accept: text/markdown` negotiation and
    // homepage Link headers; static asset folders skip it.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/ai-logos/*",
      "!/brand/*",
      "!/brand-logos/*",
      "!/fonts/*",
      "!/images/*",
      "!/logos/*",
      "!/ssg-logos/*",
      "!/tweets/*",
      "!/videos/*"
    ]
  }
}
