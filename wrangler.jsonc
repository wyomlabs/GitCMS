{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitcms-site",
  "routes": [
    {
      "pattern": "gitcms.dev",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2025-09-02",
  // Workers Builds runs `wrangler preview` for non-main branches, which requires this
  // block. The site has no bindings beyond assets, so previews need no overrides.
  "previews": {},
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/docs.mdx",
      "/docs/*.mdx",
      "/docs/**/*.mdx",
      "/*.md",
      "/**/*.md",
      "/llms.txt",
      "/llms-full.txt",
      "/**/llms.txt"
    ]
  }
}
