---
// Variant A — "Day Two". Framed, flat layout in the spirit of cal.com: live
// app UI in the hero, then setup, the Day Two story, change requests,
// integrations, proof, and what running a site really costs.
import { ArrowRight, Check, GitBranch, Inbox, Plug, Quote, Rocket, Search, Sparkles, Terminal } from 'lucide-react'
import { GitCMSLogo } from '@/components/gitcms-logo'
import { loginUrl } from '@/lib/start-login'
import RedesignLayout from '@/components/redesign/RedesignLayout.astro'
import ProductTour from '@/components/redesign/ProductTour.astro'
import AppWindow from '@/components/redesign/mock/AppWindow.astro'
import EditorMock from '@/components/redesign/mock/EditorMock.astro'
import SearchMock from '@/components/redesign/mock/SearchMock.astro'
import FleetMock from '@/components/redesign/mock/FleetMock.astro'
import HeroWidget from '@/components/redesign/a/HeroWidget.astro'
import { publishedTestimonials } from '@/lib/testimonials'
import ChangeRequestMock from '@/components/redesign/a/ChangeRequestMock.astro'
import Testimonials from '@/components/redesign/a/Testimonials.astro'
import CostComparator from '@/components/redesign/a/CostComparator.astro'
import SiteNav from '@/components/redesign/sections/SiteNav.astro'
import PricingTable from '@/components/redesign/sections/PricingTable.astro'
import FaqList from '@/components/redesign/sections/FaqList.astro'
import SiteFooter from '@/components/redesign/sections/SiteFooter.astro'
import { CATEGORY, DAY_TWO_REQUESTS, SUBHEAD } from '@/components/redesign/content'

// Companies whose marketing sites are code. Not customers; verify each
// before this ships.
const companies = [
  { name: 'OpenAI', logo: '/logos/openai.svg' },
  { name: 'Anthropic', logo: '/logos/anthropic.svg' },
  { name: 'Cursor', logo: '/logos/cursor.svg' },
  { name: 'Plausible', logo: '/logos/plausibleanalytics.svg' },
  { name: 'OpenCode', logo: '/ai-logos/opencode.svg' },
  { name: 'Supabase', logo: '/logos/supabase.svg' },
  { name: 'Vercel', logo: '/logos/vercel.svg' },
]

const integrations = [
  { group: 'Frameworks', items: [['Astro', '/ssg-logos/astro.svg'], ['Next.js', '/ssg-logos/nextjs.svg'], ['Nuxt', '/ssg-logos/nuxtjs.svg'], ['SvelteKit', '/ssg-logos/svelte.svg'], ['Hugo', '/ssg-logos/hugo.svg'], ['Eleventy', '/ssg-logos/eleventy.svg']] },
  { group: 'Hosting and data', items: [['GitHub', '/brand-logos/github.svg'], ['Cloudflare', '/brand-logos/cloudflare.svg'], ['Vercel', '/logos/vercel.svg'], ['Netlify', '/logos/netlify.svg'], ['Search Console', '/logos/google-search-console.svg'], ['AWS S3', '/logos/amazon-s3.svg']] },
  { group: 'Agents', items: [['ChatGPT', '/ai-logos/openai-bw.svg'], ['Claude', '/ai-logos/claude-orange.svg'], ['Grok', '/ai-logos/grok-bot.svg'], ['OpenClaw', '/ai-logos/openclaw.svg'], ['Hermes', '/ai-logos/hermes.svg'], ['Muse', '/ai-logos/muse.svg']] },
] as const

const tones: Record<string, string> = {
  amber: 'bg-amber-500',
  sky: 'bg-sky-500',
  emerald: 'bg-emerald-500',
  orange: 'bg-white border border-neutral-200',
}
const eyebrow = 'inline-flex w-fit items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-2.5 py-1 text-xs font-medium text-neutral-700'
const h2 = 'text-[34px] font-semibold leading-[1.1] tracking-[-0.035em] sm:text-[44px]'
const sub = 'text-[16px] leading-relaxed text-neutral-500'
const card = 'rounded-2xl border border-neutral-200 bg-white'
// Every section: heading on the page background, visuals in white cards.
const section = 'border-t border-neutral-200 px-6 py-24 sm:py-32 lg:px-16'
---
<RedesignLayout variant="a" title="Variant A · Day Two" bodyClass="bg-[#f4f4f3]">
  <SiteNav />
  <div class="mx-auto max-w-[1200px] border-x border-neutral-200">
    <!-- Hero -->
    <section class="p-3 sm:p-4">
      <div class:list={['grid items-center gap-14 overflow-hidden px-6 py-14 lg:grid-cols-[0.9fr_1.1fr] lg:py-24 lg:pl-16 lg:pr-0', card]}>
        <div>
          <a href="#change-requests" class={eyebrow}>
            <span class="rounded-full bg-lime-200 px-1.5 text-[10px] font-semibold text-lime-900">New</span>
            Change requests on preview deployments <ArrowRight className="size-3" />
          </a>
          <h1 class="mt-7 text-[42px] font-semibold leading-[1.03] tracking-[-0.04em] sm:text-[52px]">
            Your agent built the site. <span class="text-neutral-400">Now your team can run it.</span>
          </h1>
          <p class:list={['mt-6 max-w-lg text-[17px]', 'leading-relaxed text-neutral-500']}>{SUBHEAD}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={loginUrl('/')} class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-5 py-3 text-sm font-medium text-white hover:bg-neutral-800">Connect your site, free <ArrowRight className="size-4" /></a>
            <a href="#product" class="inline-flex items-center rounded-lg border border-neutral-200 bg-white px-5 py-3 text-sm font-medium hover:bg-neutral-50">See how it works</a>
          </div>
          <p class="mt-6 text-[13px] text-neutral-400">Free to explore · No migration · Works with your framework and host</p>
        </div>
        <div class="min-w-0">
          <!-- Bleeds past the card's right edge, which crops it (cal.com). -->
          <div class="overflow-hidden lg:overflow-visible"><HeroWidget /></div>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 text-[13px] text-neutral-500">
            <span class="flex items-center gap-2.5">
              <span class="flex -space-x-2">
                {publishedTestimonials.filter((item) => item.avatarSrc).map((item) => <img src={item.avatarSrc} alt="" class="size-7 rounded-full object-cover ring-2 ring-white" />)}
              </span>
              Loved by agencies and writers
            </span>
            <span class="flex items-center gap-2">
              {['/ai-logos/claude-orange.svg', '/ai-logos/openai-bw.svg', '/ai-logos/cursor.svg'].map((logo) => <img src={logo} alt="" class="size-4" />)}
              Works with your agents
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Companies -->
    <section class="grid items-center gap-6 border-y border-neutral-200 px-8 py-12 md:grid-cols-[170px_1fr] lg:px-16">
      <p class="text-sm leading-snug text-neutral-500">The best product sites ship as code now</p>
      <div class="group overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)]">
        <div class="marquee flex w-max items-center group-hover:[animation-play-state:paused]">
          {[0, 1].map((copy) => (
            <div class="flex items-center gap-14 pr-14" aria-hidden={copy === 1 ? 'true' : undefined}>
              {companies.map((company) => (
                <span class="flex shrink-0 items-center gap-2 text-[17px] font-semibold tracking-tight text-neutral-500"><img src={company.logo} alt="" class="size-[18px] opacity-60" />{company.name}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class:list={[section, 'border-t-0 text-center']}>
      <span class={eyebrow}><Rocket className="size-3.5" /> How it works</span>
      <h2 class:list={['mx-auto mt-5 max-w-3xl', h2]}>From repository to client-ready in minutes</h2>
      <p class:list={['mx-auto mt-5 max-w-xl', sub]}>No migration and no new hosting. GitCMS reads what’s already in your repo.</p>
      <div class="mt-16 grid gap-5 text-left md:grid-cols-3">
        <div class:list={['flex min-w-0 flex-col p-6 sm:p-8', card]}>
          <span class="w-fit rounded-md bg-neutral-100 px-2 py-0.5 font-mono text-xs text-neutral-500">01</span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">Connect your repository</h3>
          <p class="mt-1 text-[15px] leading-relaxed text-neutral-500">GitCMS finds your sites, framework and content folders, and fills in the setup.</p>
          <div class="mt-8 space-y-2.5 rounded-xl border border-neutral-200 bg-neutral-50 p-5 text-[12px]">
            <div class="flex items-center gap-2 rounded-md border border-neutral-200 bg-white px-2.5 py-2"><img src="/brand-logos/github.svg" alt="" class="size-3.5" /> acme/roofing-site <span class="ml-auto text-neutral-400">main</span></div>
            <div class="flex items-center gap-2 rounded-md border border-neutral-200 bg-white px-2.5 py-2"><img src="/ssg-logos/astro.svg" alt="" class="size-3.5" /> Astro detected <Check className="ml-auto size-3.5 text-emerald-600" /></div>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {['Services', 'Blog', 'Locations', 'Site data'].map((name) => <span class="rounded-md border border-neutral-200 bg-white px-2 py-0.5 text-neutral-600">{name}</span>)}
            </div>
          </div>
        </div>
        <div class:list={['flex min-w-0 flex-col p-6 sm:p-8', card]}>
          <span class="w-fit rounded-md bg-neutral-100 px-2 py-0.5 font-mono text-xs text-neutral-500">02</span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">Invite people and agents</h3>
          <p class="mt-1 text-[15px] leading-relaxed text-neutral-500">Clients and teammates by email. Agents over MCP, with the same rules.</p>
          <div class="mt-8 space-y-2.5 rounded-xl border border-neutral-200 bg-neutral-50 p-5 text-[12px]">
            {[['J', 'bg-amber-500', 'jess@acmeroofing.com', 'Client'], ['S', 'bg-sky-500', 'sam@brightside.studio', 'Editor']].map(([initial, color, email, role]) => (
              <div class="flex items-center gap-2 rounded-md border border-neutral-200 bg-white px-2.5 py-2">
                <span class:list={['grid size-5 place-items-center rounded-full text-[9px] font-semibold text-white', color]}>{initial}</span>{email}<span class="ml-auto text-neutral-400">{role}</span>
              </div>
            ))}
            <div class="flex items-center gap-2 rounded-md border border-neutral-200 bg-white px-2.5 py-2">
              <img src="/ai-logos/claude-orange.svg" alt="" class="size-4" /><img src="/ai-logos/openai-bw.svg" alt="" class="size-4" />Agents connected<span class="ml-auto text-neutral-400">Draft only</span>
            </div>
          </div>
        </div>
        <div class:list={['flex min-w-0 flex-col p-6 sm:p-8', card]}>
          <span class="w-fit rounded-md bg-neutral-100 px-2 py-0.5 font-mono text-xs text-neutral-500">03</span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">Review on a real preview</h3>
          <p class="mt-1 text-[15px] leading-relaxed text-neutral-500">Every draft gets the preview deployment your host already builds. GitCMS finds it for you.</p>
          <div class="mt-8 space-y-2.5 rounded-xl border border-neutral-200 bg-neutral-50 p-5 text-[12px]">
            <div class="flex items-center gap-2 rounded-md border border-neutral-200 bg-white px-2.5 py-2"><span class="size-1.5 rounded-full bg-emerald-500"></span> Preview ready <span class="ml-auto truncate text-neutral-400">draft-57.acme-roofing.pages.dev</span></div>
            <div class="grid grid-cols-3 gap-1.5">
              {[['Cloudflare', '/brand-logos/cloudflare.svg'], ['Vercel', '/logos/vercel.svg'], ['Netlify', '/logos/netlify.svg']].map(([name, logo]) => (
                <span class="flex items-center justify-center gap-1.5 rounded-md border border-neutral-200 bg-white px-2 py-2 text-neutral-600"><img src={logo} alt="" class="size-3.5" />{name}</span>
              ))}
            </div>
            <div class="flex items-center gap-2 rounded-md bg-neutral-900 px-2.5 py-2 text-white">Open preview <ArrowRight className="ml-auto size-3.5" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Day One → Day Two -->
    <section class:list={[section, 'text-center']}>
      <span class={eyebrow}><Terminal className="size-3.5" /> {CATEGORY}</span>
      <h2 class:list={['mx-auto mt-5 max-w-3xl', h2]}>AI made websites cheap to build. It didn’t make them easy to run.</h2>
      <p class:list={['mx-auto mt-5 max-w-2xl', sub]}>The site shipped in an afternoon. Then everyone needs a change, and none of them should need your codebase, or you.</p>
      <div class="mt-16 grid items-center gap-8 text-left lg:grid-cols-[1fr_auto_1.3fr_auto_1fr]">
        <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-4 font-mono text-[12px] text-neutral-300">
          <div class="flex items-center gap-1.5 text-neutral-500"><Terminal className="size-3.5" /> Day one</div>
          <div class="mt-3"><span class="text-lime-300">❯</span> claude "build our new roofing site"</div>
          <div class="mt-1 text-neutral-500">Astro · 14 pages · deployed</div>
          <div class="mt-3 flex items-center gap-1.5 text-emerald-400"><Check className="size-3.5" /> Live at acme-roofing.com</div>
        </div>
        <div class="hidden text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-400 lg:block">Day<br />two</div>
        <div class="grid gap-3">
          {DAY_TWO_REQUESTS.map((request) => (
            <div class="flex items-center gap-3 rounded-xl border border-neutral-200 bg-white px-3 py-2.5">
              <span class:list={['grid size-7 place-items-center rounded-full text-[11px] font-semibold text-white', tones[request.tone]]}>
                {request.avatar === 'agent' ? <img src="/ai-logos/claude-orange.svg" alt="" class="size-4" /> : request.avatar}
              </span>
              <span class="text-sm font-medium">{request.who}</span>
              <span class="truncate text-sm text-neutral-500">{request.ask}</span>
            </div>
          ))}
        </div>
        <svg viewBox="0 0 60 180" class="hidden h-44 w-14 text-neutral-300 lg:block" aria-hidden="true">
          {[22, 67, 113, 158].map((y) => <path d={`M0 ${y} C 30 ${y}, 30 90, 60 90`} fill="none" stroke="currentColor" stroke-width="1.5" class="rd-flow" />)}
        </svg>
        <div class:list={['p-4', card]}>
          <div class="flex items-center gap-2"><GitCMSLogo className="size-6" /><span class="font-logo text-lg font-medium">GitCMS</span></div>
          <div class="mt-3 space-y-1.5 text-[13px]">
            {[['Draft', 'bg-sky-500'], ['Review', 'bg-violet-500'], ['Published', 'bg-emerald-500']].map(([label, dot]) => (
              <div class="flex items-center gap-2 rounded-md border border-neutral-200 px-2.5 py-1.5"><span class:list={['size-1.5 rounded-full', dot]}></span>{label}</div>
            ))}
          </div>
          <div class="mt-3 text-[12px] text-neutral-500">Every publish is a commit to your repo.</div>
        </div>
      </div>
    </section>

    <!-- Product tour -->
    <section id="product" class:list={[section, 'text-center']}>
      <span class={eyebrow}><GitBranch className="size-3.5" /> One workflow</span>
      <h2 class:list={['mt-5', h2]}>People and agents, same rules</h2>
      <p class:list={['mx-auto mt-5 max-w-xl', sub]}>Whoever starts the change, it ends the same way: a draft, a review, and a commit.</p>
      <div class="mt-16 text-left"><ProductTour /></div>
    </section>

    <!-- Change requests -->
    <section id="change-requests" class={section}>
      <div class="text-center">
        <span class={eyebrow}><span class="rounded-full bg-lime-200 px-1.5 text-[10px] font-semibold text-lime-900">New</span> Change requests</span>
        <h2 class:list={['mx-auto mt-5 max-w-3xl', h2]}>Feedback pinned to the page, not buried in email</h2>
        <p class:list={['mx-auto mt-5 max-w-2xl', sub]}>Clients click the thing they want changed. Each pin becomes a change request your coding agent can pick up with one copied prompt. When the fix deploys, GitCMS finds the preview and checks every pin against it.</p>
      </div>
      <AppWindow url="app.gitcms.dev/sites/acme-roofing.com/change-requests/61" class="mt-16">
        <div class="h-[440px]"><ChangeRequestMock /></div>
      </AppWindow>
      <div class="mt-3 grid gap-5 sm:grid-cols-3">
        {[
          ['Select element', 'Feedback lands on the exact heading, image or button.'],
          ['Copy prompt', 'Hand open feedback to Claude Code, Codex or Cursor.'],
          ['Verify on the preview', 'Pins show as changed, still matching, or gone.'],
        ].map(([title, body]) => (
          <div class:list={['p-7 text-[14px] leading-relaxed text-neutral-500', card]}><span class="block font-medium text-neutral-900">{title}</span>{body}</div>
        ))}
      </div>
    </section>

    <!-- Integrations -->
    <section class={section}>
      <div class="text-center">
        <span class={eyebrow}><Plug className="size-3.5" /> Integrations</span>
        <h2 class:list={['mx-auto mt-5 max-w-3xl', h2]}>Your stack. Your agents. Your search data.</h2>
        <p class:list={['mx-auto mt-5 max-w-2xl', sub]}>GitCMS works with the framework and host you already use. Connect Search Console, and the agents you already rely on, like OpenClaw, Hermes or Grok, become content agents: they see what ranks, draft the fix, and wait for a person to approve it.</p>
      </div>
      <div class="mt-16 grid gap-5 lg:grid-cols-3">
        {integrations.map((group) => (
          <div class:list={['p-7', card]}>
            <div class="text-sm font-medium text-neutral-900">{group.group}</div>
            <div class="mt-4 grid grid-cols-3 gap-2">
              {group.items.map(([name, logo]) => (
                <div class="flex flex-col items-center gap-2 rounded-xl border border-neutral-200 py-3.5 text-[11px] text-neutral-500">
                  <img src={logo} alt="" class="size-6" />{name}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SEO + Search Console -->
    <section id="seo" class={section}>
      <div class="text-center">
        <span class={eyebrow}><Search className="size-3.5" /> SEO <span class="rounded-full bg-lime-200 px-1.5 text-[10px] font-semibold text-lime-900">Soon</span></span>
        <h2 class:list={['mt-5', h2]}>The SEO plugin, without the plugin</h2>
        <p class:list={['mx-auto mt-5 max-w-2xl', sub]}>A search preview and a pre-publish checklist in the editor, and Search Console next to the page it’s about. See what each page ranks for, and turn a page-two keyword into a content task for a writer or your agent.</p>
      </div>
      <AppWindow url="app.gitcms.dev/sites/acme-roofing.com/services/emergency-roof-repair?panel=seo" class="mt-16">
        <div class="h-[440px]"><EditorMock panel="seo" /></div>
      </AppWindow>
      <div class:list={['mt-3 h-[400px] overflow-hidden', card]}><SearchMock /></div>
    </section>

    <!-- Testimonials -->
    <section class="border-t border-neutral-200 py-24 sm:py-32">
      <div class="px-6 text-center">
        <span class={eyebrow}><Quote className="size-3.5" /> Testimonials</span>
        <h2 class:list={['mt-5', h2]}>Don’t just take our word for it</h2>
        <p class:list={['mx-auto mt-5 max-w-xl', sub]}>Agencies, writers and startups who moved their sites to code, and handed them over with GitCMS.</p>
      </div>
      <div class="mt-16"><Testimonials /></div>
    </section>

    <!-- Agencies -->
    <section class={section}>
      <div class="text-center">
        <span class={eyebrow}><Inbox className="size-3.5" /> For agencies</span>
        <h2 class:list={['mt-5', h2]}>Every client site, one workspace</h2>
        <p class:list={['mx-auto mt-5 max-w-2xl', sub]}>Build with Astro or Next.js and your favourite agent. Every client gets a safe place to edit, and you see every site, review and agent at a glance, with no WordPress to patch.</p>
        <a href="/for-agencies" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium">GitCMS for agencies <ArrowRight className="size-4" /></a>
      </div>
      <div class:list={['mx-auto mt-16 h-[300px] max-w-3xl overflow-hidden', card]}><FleetMock /></div>
    </section>

    <!-- Cost comparator -->
    <section class={section}>
      <div class="text-center">
        <span class={eyebrow}><Sparkles className="size-3.5" /> The real cost</span>
        <h2 class:list={['mx-auto mt-5 max-w-3xl', h2]}>What a marketing site costs to run</h2>
        <p class:list={['mx-auto mt-5 max-w-2xl', sub]}>Builders charge per site and per editor. WordPress charges you in plugins and upkeep. A code-first site hosts for free; you only pay for the dashboard.</p>
      </div>
      <div class="mt-16"><CostComparator /></div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class={section}>
      <div class="text-center">
        <span class={eyebrow}><Rocket className="size-3.5" /> Pricing</span>
        <h2 class:list={['mt-5', h2]}>Pay for sites, not seats</h2>
        <p class:list={['mx-auto mt-5 max-w-xl', sub]}>Unlimited people and agents on paid plans. Bring your own AI; we don’t resell credits.</p>
      </div>
      <div class:list={['mt-16 p-5 sm:p-8', card]}><PricingTable /></div>
    </section>

    <!-- FAQ -->
    <section class={section}>
      <div class="text-center">
        <span class={eyebrow}><Quote className="size-3.5" /> FAQ</span>
        <h2 class:list={['mt-5', h2]}>Questions, answered</h2>
      </div>
      <div class:list={['mx-auto mt-16 max-w-3xl px-8 py-3 [&>div]:border-y-0', card]}><FaqList /></div>
    </section>

    <!-- CTA -->
    <section class="p-3 sm:p-4">
      <div class="rounded-2xl bg-neutral-950 px-6 py-24 text-center text-white">
        <h2 class="mx-auto max-w-2xl text-[36px] font-semibold leading-tight tracking-[-0.035em] sm:text-[48px]">Give your website a control plane</h2>
        <p class="mx-auto mt-4 max-w-lg text-neutral-400">Connect the repository behind your site. Your team is editing in minutes, and nothing about your stack changes.</p>
        <a href={loginUrl('/')} class="mt-8 inline-flex items-center gap-2 rounded-lg bg-lime-300 px-5 py-3 text-sm font-semibold text-neutral-950 hover:bg-lime-200">Connect your site, free <ArrowRight className="size-4" /></a>
      </div>
    </section>
  </div>
  <SiteFooter />
</RedesignLayout>

<style>
  /* Logo strip: one copy's width per loop, so the seam never shows. */
  .marquee { animation: a-marquee 36s linear infinite; }
  @keyframes a-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee { animation: none; } }
</style>
