---
import { ArrowRight } from 'lucide-react'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card } from '@/components/site/styles'
import { useCases } from '@/lib/use-cases'
---
<MarketingLayout
  title="Who GitCMS Is For — Agencies, Startups, Freelancers and Solo Builders"
  description="See how agencies, startups, freelancers, and solo builders use GitCMS to let clients, teams, and AI agents edit, review, and publish code-first websites."
>
  <Section first>
    <SectionHeading level={1} eyebrow="Use cases" title="Who runs your website after it ships?" description="Whether you hand sites to clients, need your team to keep the website moving, or run it yourself, start with the page that matches your setup." />
    <div class="mx-auto mt-16 grid max-w-5xl gap-5 md:grid-cols-2">
      {useCases.map((useCase) => (
        <a href={useCase.path} class:list={['group flex flex-col p-8 transition-colors hover:border-neutral-300', card]}>
          <span class="text-[13px] font-medium text-[#898989]">For {useCase.name.toLowerCase()}</span>
          <h2 class="mt-3 text-[22px] font-semibold leading-snug tracking-[-0.02em] text-neutral-900">{useCase.title}</h2>
          <p class="mt-3 flex-1 text-[14.5px] leading-relaxed text-[#898989]">{useCase.pains[0]?.body}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-medium text-neutral-900">Read the {useCase.name.toLowerCase()} page <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></span>
        </a>
      ))}
    </div>
  </Section>
  <CtaBand />
</MarketingLayout>
