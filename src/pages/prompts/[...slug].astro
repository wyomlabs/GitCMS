---
import { getCollection, render } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import ArticleHeader from '@/components/site/ArticleHeader.astro'
import CopyButton from '@/components/site/CopyButton.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card, prose } from '@/components/site/styles'
import {
  PROMPT_CATEGORY_LABELS,
  resourceMdxComponents,
} from '@/components/resources/resource-mdx-components'
import { promptText } from '@/lib/prompt-text'
import { PRODUCT_NAME } from '@/lib/positioning'

export async function getStaticPaths() {
  return (await getCollection('prompts')).map((prompt) => ({
    params: { slug: prompt.id.replace(/\.mdx?$/, '') },
    props: { prompt },
  }))
}
const { prompt } = Astro.props
const { Content } = await render(prompt)
const slug = prompt.id.replace(/\.mdx?$/, '')
const text = promptText(prompt.body)
const allPrompts = await getCollection('prompts')
const related = allPrompts
  .filter((candidate) => candidate.data.category === prompt.data.category && candidate.id !== prompt.id)
  .slice(0, 4)
  .map((candidate) => ({ title: candidate.data.title, slug: candidate.id.replace(/\.mdx?$/, '') }))
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: prompt.data.title,
  description: prompt.data.description,
  url: `https://gitcms.dev/prompts/${slug}/`,
  dateModified: prompt.data.lastReviewed,
  publisher: { '@type': 'Organization', name: PRODUCT_NAME },
}
---
<MarketingLayout title={`${prompt.data.title} — Prompt | GitCMS`} description={prompt.data.description} structuredData={structuredData}>
  <Section first>
    <ArticleHeader breadcrumbs={[{ label: 'Prompt library', href: '/prompts/' }, { label: PROMPT_CATEGORY_LABELS[prompt.data.category] }]} title={prompt.data.title} description={prompt.data.description}>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        {prompt.data.agents.map((agent) => <span class="rounded-full bg-white px-2.5 py-0.5 text-[12px] font-medium text-neutral-600 ring-1 ring-neutral-200">{agent}</span>)}
      </div>
      {text && <div class="mt-8 flex justify-center"><CopyButton tone="lime" text={text} label="Copy prompt" copiedLabel="Copied. Paste it into your agent" /></div>}
    </ArticleHeader>
    <article class:list={['mx-auto mt-12 max-w-3xl px-6 py-10 sm:px-12 sm:py-14', card]}>
      <div class={prose}><Content components={resourceMdxComponents} /></div>
      {related.length > 0 && (
        <aside class="mt-14 border-t border-neutral-200 pt-8">
          <h2 class="text-[13px] font-medium text-[#898989]">More {PROMPT_CATEGORY_LABELS[prompt.data.category].toLowerCase()} prompts</h2>
          <ul class="mt-3 space-y-2">
            {related.map((item) => <li><a href={`/prompts/${item.slug}/`} class="text-[15px] text-neutral-700 underline-offset-2 hover:text-neutral-900 hover:underline">{item.title}</a></li>)}
          </ul>
        </aside>
      )}
    </article>
  </Section>
  <CtaBand title="Agents draft. People approve." description="Connect your site to GitCMS, turn on review before publish, and every content change from a prompt waits for a person before it ships." />
</MarketingLayout>
