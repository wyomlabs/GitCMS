---
import { getCollection } from 'astro:content'
import ContentLayout from '@/layouts/ContentLayout.astro'
import {
  GLOSSARY_CATEGORY_LABELS,
  GLOSSARY_CATEGORY_ORDER,
} from '@/components/resources/resource-mdx-components'

const DESCRIPTION =
  'Plain-language definitions for code-first websites: how they’re built and rendered, the content formats and Git behind them, and running them with people and AI agents.'
const terms = (await getCollection('glossary'))
  .map((term) => ({ ...term, slug: term.id.replace(/\.mdx?$/, '') }))
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
const letters = Array.from(new Set(terms.map((term) => term.data.title.charAt(0).toUpperCase())))
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'GitCMS Glossary',
  description: DESCRIPTION,
  url: 'https://gitcms.dev/glossary/',
  hasDefinedTerm: terms.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.data.title,
    description: term.data.definition,
    url: `https://gitcms.dev/glossary/${term.slug}/`,
  })),
}
---
<ContentLayout
  title="Glossary — Code-First Websites, Rendering, Git, and AI Agents | GitCMS"
  description={DESCRIPTION}
  path="/glossary"
  structuredData={structuredData}
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <header class="max-w-3xl">
      <div class="text-sm font-medium uppercase tracking-widest text-neutral-500">Glossary</div>
      <h1 class="mt-4 font-logo text-4xl font-normal leading-tight tracking-tight text-neutral-900 sm:text-5xl">The language of code-first websites</h1>
      <p class="mt-6 text-base leading-relaxed text-neutral-600 sm:text-lg">How websites get built, rendered, and deployed now, the formats and Git behind them, how they get found in search and AI answers, and what it takes to run them after launch.</p>
    </header>

    <nav aria-label="Glossary categories" class="mt-10 flex flex-wrap gap-2">
      {GLOSSARY_CATEGORY_ORDER.map((category) => (
        <a href={`#${category}`} class="rounded-full border border-neutral-200 px-3 py-1.5 text-sm text-neutral-600 transition-colors hover:border-neutral-400 hover:text-neutral-900">
          {GLOSSARY_CATEGORY_LABELS[category]}
        </a>
      ))}
    </nav>

    <div class="mt-14 space-y-14">
      {GLOSSARY_CATEGORY_ORDER.map((category) => {
        const items = terms.filter((term) => term.data.category === category)
        if (items.length === 0) return null
        return (
          <div id={category} class="scroll-mt-24">
            <h2 class="border-b border-neutral-200 pb-3 font-logo text-2xl font-normal tracking-tight text-neutral-900">{GLOSSARY_CATEGORY_LABELS[category]}</h2>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {items.map((term) => (
                <a href={`/glossary/${term.slug}`} class="group rounded-xl border border-neutral-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-neutral-300 hover:shadow-lg">
                  <h3 class="font-logo text-lg font-medium tracking-tight text-neutral-900">{term.data.title}</h3>
                  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600">{term.data.definition}</p>
                </a>
              ))}
            </div>
          </div>
        )
      })}
    </div>

    <section class="mt-20 border-t border-neutral-200 pt-10">
      <h2 class="font-logo text-2xl font-normal tracking-tight text-neutral-900">A–Z</h2>
      <nav aria-label="Glossary letters" class="mt-4 flex flex-wrap gap-1">
        {letters.map((letter) => <a href={`#letter-${letter}`} class="flex size-8 items-center justify-center rounded-md text-sm font-medium text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900">{letter}</a>)}
      </nav>
      <div class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {letters.map((letter) => (
          <div id={`letter-${letter}`} class="scroll-mt-24">
            <p class="text-sm font-semibold text-neutral-900">{letter}</p>
            <ul class="mt-2 space-y-1.5">
              {terms.filter((term) => term.data.title.charAt(0).toUpperCase() === letter).map((term) => (
                <li><a href={`/glossary/${term.slug}`} class="text-sm text-neutral-600 underline-offset-2 hover:text-neutral-900 hover:underline">{term.data.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </section>
</ContentLayout>
