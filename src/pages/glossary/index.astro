---
import { getCollection } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card, heading } from '@/components/site/styles'
import {
  GLOSSARY_CATEGORY_LABELS,
  GLOSSARY_CATEGORY_ORDER,
} from '@/components/resources/resource-mdx-components'

const DESCRIPTION =
  'Plain-language definitions for code-first websites: how they’re built and rendered, the formats and Git behind them, and running them with agents.'
const terms = (await getCollection('glossary'))
  .map((term) => ({ ...term, slug: term.id.replace(/\.mdx?$/, '') }))
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
const letters = Array.from(new Set(terms.map((term) => term.data.title.charAt(0).toUpperCase())))
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'GitCMS Glossary',
  description: DESCRIPTION,
  url: 'https://gitcms.dev/glossary/',
  hasDefinedTerm: terms.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.data.title,
    description: term.data.definition,
    url: `https://gitcms.dev/glossary/${term.slug}/`,
  })),
}
---
<MarketingLayout
  title="Glossary — Code-First Websites, Rendering, Git, and AI Agents | GitCMS"
  description={DESCRIPTION}
  structuredData={structuredData}
>
  <Section first>
    <SectionHeading level={1} eyebrow="Glossary" title="The language of code-first websites" description="How websites get built, rendered, and deployed now, the formats and Git behind them, how they get found in search and AI answers, and what it takes to run them after launch." />
    <nav aria-label="Glossary categories" class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-2">
      {GLOSSARY_CATEGORY_ORDER.map((category) => (
        <a href={`#${category}`} class="rounded-full border border-neutral-200 bg-white px-3.5 py-1.5 text-[13px] font-medium text-neutral-500 transition-colors hover:text-neutral-900">
          {GLOSSARY_CATEGORY_LABELS[category]}
        </a>
      ))}
    </nav>
  </Section>

  {GLOSSARY_CATEGORY_ORDER.map((category) => {
    const items = terms.filter((term) => term.data.category === category)
    if (items.length === 0) return null
    return (
      <Section id={category} class="!py-20">
        <h2 class:list={['text-[28px]', heading]}>{GLOSSARY_CATEGORY_LABELS[category]}</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {items.map((term) => (
            <a href={`/glossary/${term.slug}/`} class:list={['group p-5 transition-colors hover:border-neutral-300', card]}>
              <h3 class="text-[16px] font-semibold tracking-[-0.01em] text-neutral-900 group-hover:text-neutral-600">{term.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-[14px] leading-relaxed text-[#898989]">{term.data.definition}</p>
            </a>
          ))}
        </div>
      </Section>
    )
  })}

  <Section class="!py-20">
    <h2 class:list={['text-[28px]', heading]}>A–Z</h2>
    <nav aria-label="Glossary letters" class="mt-5 flex flex-wrap gap-1">
      {letters.map((letter) => <a href={`#letter-${letter}`} class="flex size-8 items-center justify-center rounded-md text-[13px] font-medium text-neutral-500 hover:bg-white hover:text-neutral-900">{letter}</a>)}
    </nav>
    <div class:list={['mt-8 grid gap-x-10 gap-y-6 p-8 sm:grid-cols-2 lg:grid-cols-4', card]}>
      {letters.map((letter) => (
        <div id={`letter-${letter}`}>
          <p class="text-[13px] font-semibold text-neutral-900">{letter}</p>
          <ul class="mt-2 space-y-1.5">
            {terms.filter((term) => term.data.title.charAt(0).toUpperCase() === letter).map((term) => (
              <li><a href={`/glossary/${term.slug}/`} class="text-[14px] text-neutral-500 underline-offset-2 hover:text-neutral-900 hover:underline">{term.data.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>
  <CtaBand />
</MarketingLayout>
