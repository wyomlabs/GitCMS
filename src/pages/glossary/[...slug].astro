---
import { getCollection, render } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import ArticleHeader from '@/components/site/ArticleHeader.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card, prose } from '@/components/site/styles'
import {
  GLOSSARY_CATEGORY_LABELS,
  resourceMdxComponents,
} from '@/components/resources/resource-mdx-components'

export async function getStaticPaths() {
  return (await getCollection('glossary')).map((term) => ({
    params: { slug: term.id.replace(/\.mdx?$/, '') },
    props: { term },
  }))
}

const { term } = Astro.props
const { Content } = await render(term)
const slug = term.id.replace(/\.mdx?$/, '')
const allTerms = await getCollection('glossary')
const related = (term.data.related ?? []).flatMap((relatedSlug) => {
  const found = allTerms.find((candidate) => candidate.id.replace(/\.mdx?$/, '') === relatedSlug)
  return found ? [{ title: found.data.title, slug: relatedSlug }] : []
})
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term.data.title,
  description: term.data.definition,
  url: `https://gitcms.dev/glossary/${slug}/`,
  inDefinedTermSet: 'https://gitcms.dev/glossary/',
}
const title = term.data.title.includes(' vs ')
  ? `${term.data.title}: Differences Explained — GitCMS Glossary`
  : `What Is ${term.data.title}? — GitCMS Glossary`
---
<MarketingLayout title={title} description={term.data.description} structuredData={structuredData}>
  <Section first>
    <ArticleHeader breadcrumbs={[{ label: 'Glossary', href: '/glossary/' }, { label: GLOSSARY_CATEGORY_LABELS[term.data.category], href: `/glossary/#${term.data.category}` }]} title={term.data.title} />
    <article class:list={['mx-auto mt-12 max-w-3xl px-6 py-10 sm:px-12 sm:py-14', card]}>
      <p class="rounded-xl bg-[#DCF986]/30 px-5 py-4 text-[17px] leading-relaxed text-neutral-800 ring-1 ring-[#B5D74E]/40">{term.data.definition}</p>
      <div class:list={['mt-10', prose]}><Content components={resourceMdxComponents} /></div>
      {related.length > 0 && (
        <aside class="mt-14 border-t border-neutral-200 pt-8">
          <h2 class="text-[13px] font-medium text-[#898989]">Related terms</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {related.map((item) => <a href={`/glossary/${item.slug}/`} class="rounded-full border border-neutral-200 px-3.5 py-1.5 text-[13px] text-neutral-700 transition-colors hover:border-neutral-400 hover:text-neutral-900">{item.title}</a>)}
          </div>
        </aside>
      )}
    </article>
  </Section>
  <CtaBand title="Your AI built the website. Give your team a way to run it." description="Connect your repository and explore GitCMS on your real site in preview mode." />
</MarketingLayout>
