---
import { getCollection, render } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import ArticleHeader from '@/components/site/ArticleHeader.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card, prose } from '@/components/site/styles'
import { resourceMdxComponents } from '@/components/resources/resource-mdx-components'
import GitHubRepoForm from '@/components/tools/github-repo-form.astro'
import ToolEmbed from '@/components/tools/tool-embed.astro'
import { PRODUCT_NAME } from '@/lib/positioning'

export async function getStaticPaths() {
  return (await getCollection('tools')).map((tool) => ({
    params: { slug: tool.id.replace(/\.mdx?$/, '') },
    props: { tool },
  }))
}

const { tool } = Astro.props
const { Content } = await render(tool)
const slug = tool.id.replace(/\.mdx?$/, '')
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.data.title,
  description: tool.data.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: PRODUCT_NAME },
}
---
<MarketingLayout title={`${tool.data.title} | GitCMS Tools`} description={tool.data.description} structuredData={structuredData}>
  <Section first>
    <ArticleHeader breadcrumbs={[{ label: 'Free tools', href: '/tools/' }, { label: tool.data.title }]} title={tool.data.title} description={tool.data.description} />
    <div class="mt-12">
      {tool.data.tool === 'github-repo'
        ? <div class="mx-auto max-w-3xl"><GitHubRepoForm /></div>
        : <ToolEmbed tool={tool.data.tool} title={tool.data.title} />}
    </div>
    <article class:list={['mx-auto mt-12 max-w-3xl px-6 py-10 sm:px-12 sm:py-14', card]}>
      <div class={prose}><Content components={resourceMdxComponents} /></div>
    </article>
  </Section>
  <CtaBand title="Edit your whole site the same way" description="GitCMS opens the Markdown in your GitHub repository in this editor, so writers and AI agents can update content while every save stays a commit." />
</MarketingLayout>
