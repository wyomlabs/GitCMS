---
import { ArrowRight, Bot, Quote, Terminal, Workflow } from 'lucide-react'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import CopyButton from '@/components/site/CopyButton.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import FaqList from '@/components/site/FaqList.astro'
import ProductTour from '@/components/sections/ProductTour.astro'
import ConnectionMethods from '@/components/agents/ConnectionMethods.astro'
import { card, primaryButton } from '@/components/site/styles'
import { AGENT_FAMILY_DESCRIPTIONS, AGENT_FAMILY_LABELS, SHARED_AGENT_FAMILIES, SHARED_AGENT_FAQS, getAgentsByFamily } from '@/lib/agent-data'
import { MCP_CONNECTOR_URL } from '@/lib/mcp'
import { faqStructuredData } from '@/lib/structured-data'

const steps = [
  { title: 'An agent proposes', body: 'Research, drafts and page changes arrive as one visible content task.' },
  { title: 'People review', body: 'Your team edits the work, leaves feedback, and decides when it’s ready.' },
  { title: 'GitCMS publishes', body: 'Approved changes are committed to your repository, which stays the source of truth.' },
]
---
<MarketingLayout
  title="GitCMS for AI Agents — Draft, Review, and Publish Safely"
  description="Connect ChatGPT, Claude, and personal agents like OpenClaw and Hermes to your website. Agents draft changes; people review and publish."
  path="/agents"
  structuredData={faqStructuredData(SHARED_AGENT_FAQS)}
>
  <Section first>
    <SectionHeading level={1} eyebrow="Agents and MCP" icon={Bot} title="Give every agent a safe way to work on your website" description="Connect the AI tools you already use to research, draft and propose changes. GitCMS gives every change, from an agent or a person, the same review and publishing rules.">
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#connect" class={primaryButton}>Connect an agent <ArrowRight className="size-4" /></a>
        <CopyButton text={MCP_CONNECTOR_URL} label="Copy connector URL" copiedLabel="Connector URL copied" />
      </div>
    </SectionHeading>
    <div class="mx-auto mt-16 grid max-w-5xl gap-5 md:grid-cols-2">
      {SHARED_AGENT_FAMILIES.map((family) => (
        <div class:list={['flex flex-col p-8', card]}>
          <h2 class="text-[22px] font-semibold tracking-[-0.02em]">{AGENT_FAMILY_LABELS[family]}s</h2>
          <p class="mt-2 flex-1 text-[14.5px] leading-relaxed text-[#898989]">{AGENT_FAMILY_DESCRIPTIONS[family]}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {getAgentsByFamily(family).map((agent) => (
              <a href={`/agents/${agent.slug}`} class="inline-flex items-center gap-2 rounded-full border border-neutral-200 px-3 py-1.5 text-[13px] font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:text-neutral-950">
                <img src={agent.logoPath} alt="" class="size-4 object-contain" /> {agent.name}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="product">
    <SectionHeading eyebrow="One workflow" icon={Workflow} title="Agents propose. People approve." description="The agent can change, but the path to your website doesn’t. On sites with review before publish, every draft stays visible and reviewable in its content task until your team publishes it." />
    <ol class="mt-16 grid gap-5 md:grid-cols-3">
      {steps.map((step, index) => (
        <li class:list={['p-7', card]}>
          <span class="grid size-6 place-items-center rounded-full bg-neutral-900 text-[11px] font-semibold text-white">{index + 1}</span>
          <h3 class="mt-4 text-[16px] font-semibold tracking-tight">{step.title}</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-[#898989]">{step.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-16 text-left"><ProductTour /></div>
  </Section>

  <Section id="connect">
    <SectionHeading eyebrow="Connect" icon={Terminal} title="One connector URL for every agent" description="Add GitCMS as a connector or remote MCP server, then sign in or send a personal access token. Each agent’s page has step-by-step setup." />
    <div class="mx-auto mt-16 grid max-w-5xl gap-5 lg:grid-cols-2">
      <div class:list={['flex flex-col justify-center p-8', card]}>
        <span class="text-[13px] font-medium text-[#898989]">Connector URL</span>
        <div class="mt-3 flex flex-wrap items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 py-1.5 pl-3 pr-1.5">
          <code class="font-mono text-[14px] text-neutral-900">{MCP_CONNECTOR_URL}</code>
          <CopyButton size="sm" text={MCP_CONNECTOR_URL} label="Copy" class="ml-auto" />
        </div>
        <p class="mt-4 text-[13px] leading-relaxed text-[#898989]">MCP requires a licensed GitCMS site. Preview mode does not unlock the connector.</p>
      </div>
      <ConnectionMethods />
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="FAQ" icon={Quote} title="Agents and GitCMS, answered" />
    <div class:list={['mx-auto mt-16 max-w-3xl px-8 py-3 [&>div]:border-y-0', card]}><FaqList faqs={SHARED_AGENT_FAQS} /></div>
  </Section>

  <CtaBand title="Keep the agent. Add the control plane." description="Agents draft through GitCMS, people review, and every published change is a commit in your repository." />
</MarketingLayout>
