---
import { getCollection, render } from 'astro:content'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import ArticleHeader from '@/components/site/ArticleHeader.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card, prose } from '@/components/site/styles'
import { formatDate } from '@/lib/format-date'
import { comparisonMdxComponents } from '@/components/comparison/mdx-components'

export async function getStaticPaths() {
  return (await getCollection('comparisons')).map((comparison) => ({
    params: { slug: comparison.id.replace(/\.mdx?$/, '') },
    props: { comparison },
  }))
}
const { comparison } = Astro.props
const { Content } = await render(comparison)
const slug = comparison.id.replace(/\.mdx?$/, '')
const canonicalUrl = `https://gitcms.dev/compare/${slug}`
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: comparison.data.title,
      description: comparison.data.description,
      dateModified: comparison.data.lastReviewed,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      publisher: {
        '@type': 'Organization',
        name: 'GitCMS',
        url: 'https://gitcms.dev',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Comparisons',
          item: 'https://gitcms.dev/compare',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: comparison.data.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
}
---
<MarketingLayout
  title={`${comparison.data.title} — GitCMS`}
  description={comparison.data.description}
  path={`/compare/${slug}`}
  structuredData={structuredData}
>
  <Section first>
    <ArticleHeader breadcrumbs={[{ label: 'Compare', href: '/compare' }, { label: `vs ${comparison.data.competitor}` }]} title={comparison.data.title} description={comparison.data.description}>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-[13px] text-[#898989]">
        <span class="rounded-full bg-white px-2.5 py-0.5 text-[12px] font-medium text-neutral-700 ring-1 ring-neutral-200">{comparison.data.category}</span>
        <span>Last reviewed {formatDate(comparison.data.lastReviewed, 'long')}</span>
      </div>
    </ArticleHeader>
    <article class:list={['mx-auto mt-12 max-w-4xl px-6 py-10 sm:px-12 sm:py-14', card]}>
      <div class={prose}>
        <Content components={comparisonMdxComponents} />
      </div>
    </article>
  </Section>
  <CtaBand />
</MarketingLayout>
