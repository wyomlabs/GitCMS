---
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card } from '@/components/site/styles'
import { getComparisons } from '@/lib/content'
const comparisons = await getComparisons()
const categoryOrder = [
  'Website builders and traditional CMS',
  'Headless CMS',
  'Git-based CMS',
  'Docs and publishing platforms',
] as const
const descriptions = {
  'Website builders and traditional CMS': 'Builders existed because code was expensive. Agents now build sites in code; the one thing you still need from a builder is the admin.',
  'Headless CMS': 'Content behind an API is a second source of truth your coding agent can’t see. For pages and posts, the repo is simpler.',
  'Git-based CMS': 'Same files-in-Git foundation. The difference is who it’s built for: developers editing Markdown, or clients, marketers, and agents running the site.',
  'Docs and publishing platforms': 'Hosted platforms for one slice of your content. A code-first site can hold docs, blog, and changelog in one repo you own.',
} satisfies Record<(typeof categoryOrder)[number], string>
const groups = categoryOrder.flatMap((category) => {
  const items = comparisons.filter((entry) => entry.data.category === category)
  return items.length > 0 ? [{ category, description: descriptions[category], items }] : []
})
---
<MarketingLayout
  title="GitCMS Comparisons — Honest CMS Comparisons"
  description="Honest comparisons between GitCMS, the CMS for code-first and AI-built websites, and headless, traditional, Git-based, and docs CMSs. We say where each tool is stronger."
  path="/compare"
>
  <Section first>
    <SectionHeading level={1} eyebrow="Compare" title="GitCMS vs everything else" description="Agents made code the fastest way to build a website. These pages compare what you use to run it after launch: website builders, headless CMSs, other Git-based CMSs, and docs platforms. Every page says where the other tool is genuinely better." />
  </Section>
  {groups.map((group) => (
    <Section>
      <SectionHeading align="left" title={group.category} description={group.description} />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {group.items.map((comparison) => (
          <a href={`/compare/${comparison.id.replace(/\.mdx?$/, '')}`} class:list={['group flex flex-col p-6 transition-colors hover:border-neutral-300', card]}>
            <h3 class="text-[20px] font-semibold tracking-[-0.02em] text-neutral-900 group-hover:text-neutral-600">vs {comparison.data.competitor}</h3>
            <p class="mt-2 flex-1 text-[14.5px] leading-relaxed text-[#898989]">{comparison.data.description}</p>
            <div class="mt-5 text-[13px] font-medium text-neutral-900">Read comparison →</div>
          </a>
        ))}
      </div>
    </Section>
  ))}
  <CtaBand />
</MarketingLayout>
