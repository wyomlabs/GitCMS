---
import { getCollection, render } from 'astro:content'
import { Callout } from 'fumadocs-ui/components/callout'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import ArticleHeader from '@/components/site/ArticleHeader.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card, prose } from '@/components/site/styles'
import { formatDate } from '@/lib/format-date'

const slugOf = (filePath: string | undefined) => (filePath ?? '').split('/').at(-1)?.replace(/\.mdx?$/, '') ?? ''

export async function getStaticPaths() {
  return (await getCollection('changelog')).map((entry) => ({
    params: { slug: (entry.filePath ?? '').split('/').at(-1)?.replace(/\.mdx?$/, '') ?? '' },
    props: { entry },
  }))
}
const { entry } = Astro.props
const { Content } = await render(entry)
const slug = slugOf(entry.filePath)
---
<MarketingLayout
  title={`${entry.data.version} — GitCMS Changelog`}
  description={entry.data.description}
  path={`/changelog/${slug}`}
  ogImage={`/changelog/${slug}/og.png`}
>
  <Section first>
    <ArticleHeader breadcrumbs={[{ label: 'Changelog', href: '/changelog' }, { label: entry.data.version }]} title={entry.data.title}>
      <div class="mt-5 flex items-center justify-center gap-2 text-[13px] text-[#898989]">
        <span class="rounded-md bg-white px-2 py-0.5 font-mono text-[12px] text-neutral-600 ring-1 ring-neutral-200">{entry.data.version}</span>
        <time datetime={entry.data.date}>{formatDate(entry.data.date, 'long')}</time>
      </div>
    </ArticleHeader>
    <article class:list={['mx-auto mt-12 max-w-3xl px-6 py-10 sm:px-12 sm:py-14', card]}>
      <div class:list={['changelog-content', prose, 'prose-h1:hidden prose-pre:border prose-pre:border-neutral-800 prose-pre:bg-neutral-950 prose-code:text-neutral-900']}>
        <Content components={{ Callout }} />
      </div>
    </article>
  </Section>
  <CtaBand />
</MarketingLayout>
