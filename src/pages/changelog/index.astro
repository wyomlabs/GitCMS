---
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import { card } from '@/components/site/styles'
import { getChangelogs } from '@/lib/content'
import { formatDate } from '@/lib/format-date'

const entries = await getChangelogs()
const slugOf = (filePath: string | undefined) => (filePath ?? '').split('/').at(-1)?.replace(/\.mdx?$/, '') ?? ''
---
<MarketingLayout title="Changelog — GitCMS" description="Product updates and release notes for GitCMS." path="/changelog">
  <Section first>
    <SectionHeading level={1} eyebrow="Changelog" title="What shipped" description="Product updates and release notes." />
    {entries.length === 0 && <p class="mt-16 text-center text-[#898989]">No releases yet. Check back soon.</p>}
    <ol class="mx-auto mt-16 max-w-4xl">
      {entries.map((entry, index) => (
        <li class="grid grid-cols-[1fr] gap-x-8 sm:grid-cols-[150px_1fr]">
          <time datetime={entry.data.date} class="pb-3 pt-1 text-[13px] font-medium text-[#898989] sm:sticky sm:top-24 sm:h-fit sm:pb-0 sm:text-right">{formatDate(entry.data.date, 'long')}</time>
          <div class:list={['relative pb-10 sm:border-l sm:border-neutral-200 sm:pl-8', index === entries.length - 1 && 'sm:border-transparent']}>
            <span class="absolute -left-[5px] top-2 hidden size-2.5 rounded-full bg-[#B5D74E] ring-4 ring-[#f4f4f4] sm:block"></span>
            <a href={`/changelog/${slugOf(entry.filePath)}`} class:list={['group block p-6 transition-colors hover:border-neutral-300', card]}>
              <span class="rounded-md bg-neutral-100 px-2 py-0.5 font-mono text-[12px] text-neutral-600">{entry.data.version}</span>
              <h2 class="mt-3 text-[20px] font-semibold tracking-[-0.02em] text-neutral-900 group-hover:text-neutral-600">{entry.data.title}</h2>
              {entry.data.description && <p class="mt-2 text-[14.5px] leading-relaxed text-[#898989]">{entry.data.description}</p>}
              <div class="mt-4 text-[13px] font-medium text-neutral-900">Read release notes →</div>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </Section>
  <CtaBand />
</MarketingLayout>
