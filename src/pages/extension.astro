---
import { ArrowRight, FileText, Github, MousePointerClick } from 'lucide-react'
import MarketingLayout from '@/layouts/MarketingLayout.astro'
import Section from '@/components/site/Section.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import CtaBand from '@/components/site/CtaBand.astro'
import StoreBadges from '@/components/site/StoreBadges.astro'
import { card } from '@/components/site/styles'

const shortcuts = [
  { icon: MousePointerClick, title: 'Right-click to open', description: 'Open a GitHub repository or Markdown link directly in GitCMS.' },
  { icon: FileText, title: 'Keep your place', description: 'Pass the selected GitHub file or folder location to GitCMS.' },
  { icon: Github, title: 'Jump from the address bar', description: 'Type gitcms, then a repository name or GitHub URL.' },
]
---
<MarketingLayout
  title="GitCMS Browser Extension for Chrome and Firefox"
  description="Open GitHub repositories, Markdown files, and folders directly in GitCMS. A free browser companion for managing code-first websites."
>
  <Section first>
    <SectionHeading level={1} eyebrow="Browser companion" title="From GitHub to GitCMS in a click" description="Open GitHub repositories, Markdown files, and folders in GitCMS, the visual CMS for code-first websites. Keep the editor, review, and publishing experience on the web, right where your team needs it.">
      <StoreBadges class="mt-8" />
      <p class="mt-4 text-[14px] text-[#898989]">Free to install. <a href="/docs/features/chrome-extension/" class="inline-flex items-center gap-1 font-medium text-neutral-900 underline underline-offset-2">How it works <ArrowRight className="size-3.5" /></a></p>
    </SectionHeading>
    <div class="mt-16 grid gap-5 sm:grid-cols-3">
      {shortcuts.map(({ icon: Icon, title, description }) => (
        <div class:list={['p-7', card]}>
          <Icon className="size-5 text-neutral-900" />
          <h2 class="mt-5 text-[16px] font-semibold">{title}</h2>
          <p class="mt-2 text-[14.5px] leading-relaxed text-[#898989]">{description}</p>
        </div>
      ))}
    </div>
  </Section>
  <CtaBand title="Your AI built the website. Now give your team a way to run it." description="The extension is a shortcut to GitCMS, not an embedded editor. GitCMS gives people and AI agents one place to edit, review, and publish while your repository stays the source of truth." />
</MarketingLayout>
