---
// Install badges for the GitCMS browser extension, in the style of the
// stores' own "Available in" badges. Icons from svgl.app.
import { EXTENSION_STORES } from '@/lib/extension'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---
<div class:list={['flex flex-wrap justify-center gap-3', className]}>
  {EXTENSION_STORES.map((store) => (
    <a href={store.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-xl border border-neutral-200 bg-white py-2.5 pl-3.5 pr-5 text-left transition-colors hover:border-neutral-300 hover:bg-neutral-50">
      <img src={store.logo} alt="" class="size-8 shrink-0" />
      <span>
        <span class="block text-[11px] leading-tight text-neutral-500">{store.eyebrow}</span>
        <span class="block text-[16px] font-medium leading-tight tracking-tight text-neutral-900">{store.name}</span>
      </span>
    </a>
  ))}
</div>
