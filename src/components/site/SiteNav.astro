---
// Floating header (cal.com): fixed 8px from the top, inset to the page
// frame, transparent over the first section and white once the page
// scrolls. Dropdowns open on hover or keyboard focus; on small screens the
// links collapse into a native <details> menu, so no menu script is needed.
import { ChevronDown, ChevronRight, Menu, X } from 'lucide-react'
import { GitCMSLogo } from '@/components/gitcms-logo'
import { loginUrl } from '@/lib/start-login'
import { RESOURCE_LINKS, USE_CASE_LINKS } from '@/lib/site-nav'

const groups = [
  { label: 'Use cases', links: USE_CASE_LINKS },
  { label: 'Resources', links: RESOURCE_LINKS },
] as const
const link = 'transition-colors hover:text-neutral-950'
---
<header class="pointer-events-none fixed inset-x-0 top-2 z-40 px-3">
  <div data-nav class="pointer-events-auto relative mx-auto flex h-[57px] max-w-[1152px] items-center gap-8 rounded-2xl border border-transparent px-5 transition-[background-color,border-color] duration-200 data-[scrolled=true]:border-neutral-200 data-[scrolled=true]:bg-white sm:px-7">
    <a href="/" class="flex items-center gap-2">
      <GitCMSLogo className="size-8" />
      <span class="font-logo text-[27px] font-medium tracking-tight text-neutral-900">GitCMS</span>
    </a>
    <nav aria-label="Primary" class="mx-auto hidden items-center gap-8 text-[14px] text-neutral-700 lg:flex">
      <a href="/#product" class={link}>Product</a>
      {groups.map((group) => (
        <div class="group relative">
          <button type="button" class:list={['flex items-center gap-1', link]}>{group.label} <ChevronDown className="size-3.5 opacity-60 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" /></button>
          <div class="invisible absolute left-1/2 top-full w-[340px] -translate-x-1/2 pt-4 opacity-0 transition-opacity duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
            <div class="rounded-2xl border border-neutral-200 bg-white p-2 shadow-[0_12px_32px_-16px_rgba(0,0,0,0.25)]">
              {group.links.map((item) => (
                <a href={item.href} class="block rounded-xl px-3 py-2.5 hover:bg-neutral-50">
                  <span class="block font-medium text-neutral-900">{item.label}</span>
                  <span class="block text-[13px] text-[#898989]">{item.blurb}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
      <a href="/agents" class={link}>Agents</a>
      <a href="/docs/" class={link}>Docs</a>
      <a href="/#pricing" class={link}>Pricing</a>
    </nav>
    <div class="ml-auto flex items-center gap-1 text-[14px] lg:ml-0">
      <a href={loginUrl('/')} class="hidden px-3 py-2 font-medium text-neutral-900 sm:inline">Sign in</a>
      <a href={loginUrl('/')} class="inline-flex h-9 items-center gap-1 whitespace-nowrap rounded-xl bg-neutral-900 pl-3.5 pr-2.5 font-medium text-white hover:bg-neutral-800">Get started <ChevronRight className="size-4 opacity-70" /></a>
      <details class="group/menu lg:hidden">
        <summary class="ml-1 grid size-9 cursor-pointer list-none place-items-center rounded-xl text-neutral-700 hover:bg-neutral-100 [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <Menu className="size-5 group-open/menu:hidden" /><X className="hidden size-5 group-open/menu:block" />
        </summary>
        <div class="absolute inset-x-0 top-full mt-2 max-h-[calc(100dvh-90px)] overflow-y-auto rounded-2xl border border-neutral-200 bg-white p-5 shadow-[0_12px_32px_-16px_rgba(0,0,0,0.25)]">
          <div class="grid gap-1 text-[15px] font-medium text-neutral-900">
            <a href="/#product" class="py-1.5">Product</a>
            <a href="/agents" class="py-1.5">Agents</a>
            <a href="/docs/" class="py-1.5">Docs</a>
            <a href="/#pricing" class="py-1.5">Pricing</a>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-6">
            {groups.map((group) => (
              <div>
                <div class="text-[12px] font-medium uppercase tracking-wide text-neutral-400">{group.label}</div>
                <div class="mt-2 grid gap-1 text-[14px] text-neutral-700">
                  {group.links.map((item) => <a href={item.href} class="py-1">{item.label}</a>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  for (const nav of document.querySelectorAll<HTMLElement>('[data-nav]')) {
    const update = () => { nav.dataset.scrolled = String(window.scrollY > 8) }
    window.addEventListener('scroll', update, { passive: true })
    update()
  }
</script>
