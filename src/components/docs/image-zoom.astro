---
import type { HTMLAttributes } from 'astro/types'
import { getPublicImageMetadata } from '@/lib/public-image-metadata'

type Props = HTMLAttributes<'img'>
const {
  class: className,
  alt = '',
  src,
  width,
  height,
  loading,
  decoding,
  sizes,
  srcset,
  ...props
} = Astro.props

const imageSrc = src ?? undefined
const metadata = imageSrc ? getPublicImageMetadata(imageSrc) : undefined
const effectiveWidth = width ?? metadata?.width
const effectiveHeight = height ?? metadata?.height

let generatedSrcset = srcset
if (!generatedSrcset && imageSrc && metadata && imageSrc.endsWith('.webp')) {
  const base = imageSrc.slice(0, -'.webp'.length)
  const candidates = []
  if (metadata.width > 640) candidates.push(`${base}-640.webp 640w`)
  if (metadata.width > 1280) candidates.push(`${base}-1280.webp 1280w`)
  candidates.push(`${imageSrc} ${metadata.width}w`)
  generatedSrcset = candidates.join(', ')
}
---

<button
  type="button"
  aria-label={`Expand ${alt || 'image'}`}
  class="gitcms-image-zoom inline-block cursor-zoom-in rounded-lg border-0 bg-transparent p-0"
>
  <img
    {...props}
    src={imageSrc}
    alt={alt}
    width={effectiveWidth}
    height={effectiveHeight}
    loading={loading ?? 'lazy'}
    decoding={decoding ?? 'async'}
    sizes={sizes ?? '(max-width: 768px) calc(100vw - 32px), 661px'}
    srcset={generatedSrcset}
    class:list={['rounded-lg border border-fd-border', className]}
  />
</button>

<script>
  function bindImageZoom() {
    for (const trigger of document.querySelectorAll<HTMLButtonElement>('.gitcms-image-zoom')) {
      if (trigger.dataset.zoomBound === 'true') continue
      trigger.dataset.zoomBound = 'true'

      trigger.addEventListener('click', () => {
        const image = trigger.querySelector('img')
        if (!image) return

        const overlay = document.createElement('button')
        overlay.type = 'button'
        overlay.ariaLabel = 'Close expanded image'
        overlay.className =
          'fixed inset-0 z-50 flex cursor-zoom-out items-center justify-center bg-black/80 p-4 backdrop-blur-sm md:p-8'

        const expanded = document.createElement('img')
        expanded.src = image.currentSrc || image.src
        expanded.alt = image.alt
        expanded.srcset = image.srcset
        expanded.sizes = image.sizes
        expanded.className = 'max-h-[90vh] max-w-[90vw] rounded-lg object-contain shadow-2xl'
        overlay.append(expanded)

        const close = () => {
          overlay.remove()
          document.body.style.overflow = ''
          document.removeEventListener('keydown', onKeyDown)
        }
        const onKeyDown = (event: KeyboardEvent) => {
          if (event.key === 'Escape') close()
        }

        overlay.addEventListener('click', close)
        document.addEventListener('keydown', onKeyDown)
        document.body.style.overflow = 'hidden'
        document.body.append(overlay)
      })
    }
  }

  bindImageZoom()
  document.addEventListener('astro:page-load', bindImageZoom)
</script>
