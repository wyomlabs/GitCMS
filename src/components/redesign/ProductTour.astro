---
// Tabbed walkthrough with a progress bar that advances on its own (pauses on
// hover, stops once someone picks a tab).
import AppWindow from './mock/AppWindow.astro'
import AgentChatMock from './mock/AgentChatMock.astro'
import BoardMock from './mock/BoardMock.astro'
import EditorMock from './mock/EditorMock.astro'
import ReviewMock from './mock/ReviewMock.astro'

const tabs = [
  { key: 'edit', label: 'Edit visually', blurb: 'Clients change copy, prices and photos in fields that match the site.', url: 'app.gitcms.dev/sites/acme-roofing.com/services/emergency-roof-repair' },
  { key: 'agent', label: 'Ask your agent', blurb: 'Claude drafts a multi-page change through GitCMS and stops at review.', url: 'claude.ai/new' },
  { key: 'review', label: 'Review changes', blurb: 'See exactly what changed, discuss it inline, approve when it’s right.', url: 'app.gitcms.dev/sites/acme-roofing.com/reviews/57' },
  { key: 'board', label: 'Track the work', blurb: 'Every request is a content task moving from idea to published.', url: 'app.gitcms.dev/sites/acme-roofing.com/board' },
] as const
---
<div data-tour class="mx-auto max-w-5xl">
  <AppWindow url={tabs[0].url} class="relative">
    <div class="relative h-[460px]">
      {tabs.map((tab, index) => (
        <div data-tour-panel={tab.key} data-url={tab.url} class:list={['absolute inset-0 transition-opacity duration-500', index !== 0 && 'pointer-events-none opacity-0']}>
          {tab.key === 'edit' && <EditorMock />}
          {tab.key === 'agent' && <AgentChatMock />}
          {tab.key === 'review' && <ReviewMock />}
          {tab.key === 'board' && <BoardMock />}
        </div>
      ))}
    </div>
  </AppWindow>
  <div class="mt-6 grid gap-4 sm:grid-cols-4" role="tablist">
    {tabs.map((tab, index) => (
      <button type="button" role="tab" data-tour-tab={tab.key} aria-selected={index === 0 ? 'true' : 'false'} class="group text-left">
        <span class="block h-0.5 overflow-hidden rounded-full bg-neutral-200">
          <span data-tour-bar class="block h-full w-0 bg-neutral-900"></span>
        </span>
        <span class="mt-3 flex items-baseline gap-2 text-sm font-medium text-neutral-400 group-aria-selected:text-neutral-900">
          <span class="font-mono text-[11px]">0{index + 1}</span>{tab.label}
        </span>
        <span class="mt-1 block text-[13px] leading-snug text-neutral-400 group-aria-selected:text-neutral-600">{tab.blurb}</span>
      </button>
    ))}
  </div>
</div>

<script>
  const DURATION = 9000
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  for (const tour of document.querySelectorAll<HTMLElement>('[data-tour]')) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[data-tour-tab]')]
    const panels = [...tour.querySelectorAll<HTMLElement>('[data-tour-panel]')]
    const url = tour.querySelector<HTMLElement>('[data-window-url]')
    let current = 0
    let started = performance.now()
    let auto = !reduce
    let paused = false

    const show = (index: number) => {
      current = index
      started = performance.now()
      tabs.forEach((tab, i) => tab.setAttribute('aria-selected', String(i === index)))
      panels.forEach((panel, i) => {
        panel.classList.toggle('opacity-0', i !== index)
        panel.classList.toggle('pointer-events-none', i !== index)
      })
      if (url) url.textContent = panels[index]?.dataset.url ?? ''
      tabs.forEach((tab, i) => {
        const bar = tab.querySelector<HTMLElement>('[data-tour-bar]')
        if (bar) bar.style.width = i < index || (!auto && i === index) ? '100%' : '0%'
      })
    }

    tabs.forEach((tab, index) => tab.addEventListener('click', () => {
      auto = false
      show(index)
    }))
    tour.addEventListener('mouseenter', () => { paused = true })
    tour.addEventListener('mouseleave', () => {
      paused = false
      started = performance.now()
    })

    const tick = (now: number) => {
      if (auto && !paused) {
        const progress = Math.min(1, (now - started) / DURATION)
        const bar = tabs[current]?.querySelector<HTMLElement>('[data-tour-bar]')
        if (bar) bar.style.width = `${progress * 100}%`
        if (progress >= 1) show((current + 1) % tabs.length)
      }
      requestAnimationFrame(tick)
    }
    show(0)
    if (auto) requestAnimationFrame(tick)
  }
</script>
