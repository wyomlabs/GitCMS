---
// Copies the agent setup prompt, the same text the app's "Set up with your
// coding agent" dialog hands out, so the two never drift.
import { Check, Copy } from 'lucide-react'
import { AGENT_SETUP_PROMPT } from '@/lib/agent-setup-prompt'

interface Props {
  tone?: 'light' | 'dark' | 'lime'
  label?: string
  class?: string
}
const { tone = 'light', label = 'Set up with your agent', class: className = '' } = Astro.props
const tones = {
  light: 'border border-neutral-200 bg-white text-neutral-900 hover:bg-neutral-50',
  dark: 'border border-white/15 bg-white/5 text-white hover:bg-white/10',
  lime: 'bg-[#DCF986] text-neutral-950 hover:bg-[#d4f47a]',
}
---
<button type="button" data-copy-prompt={AGENT_SETUP_PROMPT} class:list={['group/copy inline-flex h-10 items-center gap-2 rounded-xl px-4 text-[14px] font-medium transition-colors', tones[tone], className]}>
  <span class="contents group-data-[copied=true]/copy:hidden"><Copy className="size-4 opacity-60" /> {label}</span>
  <span class="hidden items-center gap-2 group-data-[copied=true]/copy:inline-flex"><Check className="size-4 text-emerald-500" /> Copied. Paste it into your agent</span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
    let reset: number | undefined
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copyPrompt ?? '')
      button.dataset.copied = 'true'
      window.clearTimeout(reset)
      reset = window.setTimeout(() => { button.dataset.copied = 'false' }, 2400)
    })
  }
</script>
