---
// Change Requests: review the live site or a preview inside GitCMS, pin
// feedback to elements (F1, F2…), hand it to a coding agent, then check the
// pins against the preview deployment GitCMS found for the fix.
// Mirrors DESIGN.md "Change Requests": one bordered site window, no shadow.
import { Check, Copy, MousePointerClick, RotateCw } from 'lucide-react'

const feedback = [
  { ref: 'F1', who: 'Jess', role: 'Client', text: 'Make the phone number bigger on mobile', status: 'Changed' },
  { ref: 'F2', who: 'Sam', role: 'Marketing', text: 'Use the new hail damage photo here', status: 'Changed' },
  { ref: 'F3', who: 'Jess', role: 'Client', text: 'Add “Licensed & insured” under the headline', status: 'Still matching' },
] as const
---
<div data-seq="8" data-ms="1200" data-final="7" class="grid h-full grid-cols-1 bg-white text-[12px] md:grid-cols-[1fr_300px]">
  <div class="flex min-w-0 flex-col border-neutral-200 p-3 md:border-r">
    <!-- Site browser bar -->
    <div class="flex items-center gap-2 rounded-t-lg border border-neutral-200 bg-neutral-50 px-2.5 py-1.5 text-[11px] text-neutral-500">
      <span class="inline-flex overflow-hidden rounded-md border border-neutral-200 bg-white">
        <span class="px-2 py-0.5" data-at="0" data-until="4" data-fx="collapse">Live site</span>
        <span class="px-2 py-0.5 text-neutral-400" data-at="0" data-until="4" data-fx="collapse">Preview</span>
        <span class="px-2 py-0.5 text-neutral-400" data-at="4" data-fx="collapse">Live site</span>
        <span class="bg-neutral-900 px-2 py-0.5 text-white" data-at="4" data-fx="collapse">Preview</span>
      </span>
      <span class="min-w-0 flex-1 truncate rounded-md border border-neutral-200 bg-white px-2 py-0.5">
        <span data-at="0" data-until="4" data-fx="collapse">acme-roofing.com/services</span>
        <span data-at="4" data-fx="collapse">cr-61.acme-roofing.pages.dev/services</span>
      </span>
      <RotateCw className="size-3.5" />
      <span class="inline-flex items-center gap-1 rounded-md border border-neutral-200 bg-white px-1.5 py-0.5"><MousePointerClick className="size-3.5" /> Select element</span>
    </div>
    <!-- The site under review -->
    <div class="relative flex-1 overflow-hidden rounded-b-lg border border-t-0 border-neutral-200 bg-[#f7f4ee] p-6">
      <div class="flex items-center justify-between text-[11px] text-neutral-500"><span class="font-semibold text-neutral-900">Acme Roofing</span><span>Services · Areas · Contact</span></div>
      <div class="mt-8 max-w-[70%]">
        <h4 class="relative inline-block pr-3 font-logo text-[26px] leading-tight text-neutral-900">Emergency roof repair, 24/7<span data-at="3" class="absolute -right-2.5 -top-2.5 grid size-5 place-items-center rounded-full bg-violet-600 text-[9px] font-semibold text-white ring-[3px] ring-violet-200">F3</span></h4>
        <p class="mt-1 text-[11px] text-emerald-700" data-at="5" data-fx="fade">Licensed &amp; insured</p>
        <p class="mt-2 text-[12px] text-neutral-600">Fast, insured repairs across Austin.</p>
        <div class="mt-4 flex items-center gap-2">
          <span class="relative rounded-md bg-neutral-900 px-3 py-1.5 text-[11px] font-medium text-white"><span data-at="1" class="absolute -right-2.5 -top-2.5 grid size-5 place-items-center rounded-full bg-violet-600 text-[9px] font-semibold text-white ring-[3px] ring-violet-200">F1</span>Call
            <span class="transition-all" data-at="0" data-until="4" data-fx="collapse">(512) 555-0142</span>
            <span class="text-[13px] font-semibold" data-at="4" data-fx="collapse">(512) 555-0142</span>
          </span>
        </div>
      </div>
      <div class="absolute bottom-5 right-5 h-20 w-32"><span data-at="2" class="absolute -right-2.5 -top-2.5 grid size-5 place-items-center rounded-full bg-violet-600 text-[9px] font-semibold text-white ring-[3px] ring-violet-200">F2</span><div class="absolute inset-0 overflow-hidden rounded-md">
        <div class="absolute inset-0 bg-gradient-to-br from-sky-200 to-slate-300" data-at="0" data-until="4" data-fx="fade"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-amber-200 via-orange-300 to-rose-300" data-at="4" data-fx="fade"></div>
      </div></div>
    </div>
  </div>
  <!-- Feedback panel -->
  <div class="hidden min-w-0 flex-col md:flex">
    <div class="flex items-center gap-2 border-b border-neutral-200 px-3 py-2.5">
      <span class="whitespace-nowrap text-[11px] text-neutral-500">3 open</span>
      <span class="ml-auto inline-flex items-center gap-1.5 whitespace-nowrap rounded-md border border-neutral-200 px-1.5 py-1 text-[10.5px] font-medium text-neutral-700">
        <img src="/ai-logos/claude-orange.svg" alt="" class="size-3" /><img src="/brand-logos/openai.svg" alt="" class="size-3" /><img src="/ai-logos/cursor.svg" alt="" class="size-3" />
        <Copy className="size-3" /> Copy prompt
      </span>
    </div>
    <div class="flex-1 space-y-2 overflow-hidden p-3">
      {feedback.map((item, index) => (
        <div class="rounded-lg border border-neutral-200 p-2.5" data-at={index + 1}>
          <div class="flex items-center gap-1.5 text-[10.5px] text-neutral-500">
            <span class="rounded bg-violet-50 px-1 font-semibold text-violet-700">{item.ref}</span>
            <span class="font-medium text-neutral-800">{item.who}</span>{item.role}
            <span class:list={['ml-auto inline-flex items-center gap-0.5', item.status === 'Changed' ? 'text-emerald-700' : 'text-amber-600']} data-at={5 + (index === 2 ? 1 : 0)} data-fx="fade">
              {item.status === 'Changed' && <Check className="size-3" />}{item.status}
            </span>
          </div>
          <p class="mt-1 text-[11.5px] leading-snug text-neutral-700">{item.text}</p>
        </div>
      ))}
      <div class="rounded-lg border border-dashed border-neutral-200 p-2.5 text-[10.5px] leading-snug text-neutral-500" data-at="4" data-fx="fade">
        Preview found on Cloudflare for the fix. Pins are checked against it.
      </div>
    </div>
  </div>
</div>
