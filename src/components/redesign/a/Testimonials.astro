---
// Approved customer quotes in a centered, edge-faded scroller (cal.com).
// Loops forever (three copies; the scroll position is re-centred on the
// middle one) and can be dragged with a mouse as well as swiped.
import { publishedTestimonials } from '@/lib/testimonials'

const copies = [0, 1, 2]
---
<div class="relative">
  <div data-quotes class="flex cursor-grab snap-x snap-mandatory gap-5 overflow-x-auto px-[max(1rem,calc(50%-230px))] pb-2 select-none [mask-image:linear-gradient(90deg,transparent,black_18%,black_82%,transparent)] [scrollbar-width:none] data-[dragging=true]:cursor-grabbing data-[dragging=true]:snap-none">
    {copies.map((copy) => publishedTestimonials.map((item) => (
      <figure data-quote aria-hidden={copy === 1 ? undefined : 'true'} class="flex w-[460px] max-w-[85vw] shrink-0 snap-center flex-col justify-between rounded-2xl border border-neutral-200 bg-white p-8">
        <blockquote class="text-[20px] font-medium leading-snug tracking-[-0.01em] text-neutral-900"><span aria-hidden="true" class="mb-3 block font-logo text-4xl leading-none text-neutral-300">“</span>{item.highlight}</blockquote>
        <figcaption class="mt-8 flex items-center gap-3">
          {item.avatarSrc && <img src={item.avatarSrc} alt="" class="pointer-events-none size-10 rounded-full object-cover" loading="lazy" />}
          <div class="text-sm">
            <div class="font-medium text-neutral-900">{item.name}</div>
            <div class="text-neutral-500">{item.role}{item.site && <>, {item.site.href ? <a href={item.site.href} class="hover:text-neutral-900" rel="noopener" tabindex={copy === 1 ? undefined : -1}>{item.site.label}</a> : item.site.label}</>}</div>
          </div>
        </figcaption>
      </figure>
    )))}
  </div>
  <div class="mt-8 flex justify-center gap-2">
    <button type="button" data-quotes-prev aria-label="Previous testimonial" class="grid size-9 place-items-center rounded-full border border-neutral-200 bg-white text-neutral-600 hover:text-neutral-900">←</button>
    <button type="button" data-quotes-next aria-label="Next testimonial" class="grid size-9 place-items-center rounded-full border border-neutral-200 bg-white text-neutral-600 hover:text-neutral-900">→</button>
  </div>
</div>

<script>
  for (const track of document.querySelectorAll<HTMLElement>('[data-quotes]')) {
    const root = track.parentElement
    const cards = track.querySelectorAll<HTMLElement>('[data-quote]')
    const perCopy = cards.length / 3
    const step = () => (cards[0]?.getBoundingClientRect().width ?? 400) + 20
    // Width of one full copy of the list.
    const span = () => step() * perCopy

    // Keep the position inside the middle copy so both directions never end.
    const recentre = () => {
      const offset = track.scrollLeft
      if (offset < span() * 0.5) track.scrollLeft = offset + span()
      else if (offset > span() * 1.5) track.scrollLeft = offset - span()
    }
    let settle: number | undefined
    track.addEventListener('scroll', () => {
      window.clearTimeout(settle)
      settle = window.setTimeout(recentre, 120)
    })

    root?.querySelector('[data-quotes-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    root?.querySelector('[data-quotes-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))

    // Mouse drag. Touch and trackpads already scroll natively.
    let startX = 0
    let startScroll = 0
    let moved = false
    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return
      startX = event.clientX
      startScroll = track.scrollLeft
      moved = false
      track.dataset.dragging = 'true'
      track.setPointerCapture(event.pointerId)
    })
    track.addEventListener('pointermove', (event) => {
      if (track.dataset.dragging !== 'true') return
      const delta = event.clientX - startX
      if (Math.abs(delta) > 4) moved = true
      track.scrollLeft = startScroll - delta
    })
    const endDrag = (event: PointerEvent) => {
      if (track.dataset.dragging !== 'true') return
      track.dataset.dragging = 'false'
      track.releasePointerCapture(event.pointerId)
      // Snap to the nearest card from where the drag let go.
      const nearest = Math.round((track.scrollLeft - startScroll) / step())
      track.scrollTo({ left: startScroll + nearest * step(), behavior: 'smooth' })
    }
    track.addEventListener('pointerup', endDrag)
    track.addEventListener('pointercancel', endDrag)
    // A drag shouldn't also follow a link it started on.
    track.addEventListener('click', (event) => {
      if (moved) {
        event.preventDefault()
        moved = false
      }
    }, true)

    // Start on the second quote of the middle copy so both edges show a neighbour.
    requestAnimationFrame(() => { track.scrollLeft = span() + step() })
  }
</script>
