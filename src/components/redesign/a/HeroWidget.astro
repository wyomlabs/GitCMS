---
// Hero widget in the spirit of cal.com's booking card: one focused piece of
// the product instead of a full app window. Left: a content task (who, what,
// stage). Right: the entry it changes, cropped by the hero card's edge.
import { Bot, Globe, MessageSquare } from 'lucide-react'
import { GitCMSLogo } from '@/components/gitcms-logo'

const stages = ['Draft', 'Review', 'Published'] as const
---
<div data-seq="9" data-ms="1300" data-final="5" class="grid w-[760px] max-w-none grid-cols-[280px_1fr] overflow-hidden rounded-xl border border-neutral-200 bg-white text-left">
  <!-- Task -->
  <div class="border-r border-neutral-200 p-6">
    <div class="flex -space-x-1.5">
      <span class="grid size-7 place-items-center rounded-full bg-amber-500 text-[11px] font-semibold text-white ring-2 ring-white">J</span>
      <span class="grid size-7 place-items-center rounded-full border border-neutral-200 bg-white ring-2 ring-white"><img src="/ai-logos/claude-orange.svg" alt="" class="size-4" /></span>
    </div>
    <p class="mt-3 text-[13px] text-neutral-500">Jess Carter · with Claude</p>
    <h3 class="mt-0.5 text-[19px] font-semibold tracking-tight text-neutral-900">Q4 pricing update</h3>
    <p class="mt-2 text-[13px] leading-relaxed text-neutral-500">New starting price and 24/7 emergency service across the services pages.</p>
    <div class="mt-5 flex items-center gap-2">
      <span class="text-neutral-400"><GitCMSLogo className="size-4" /></span>
      <div class="relative grid flex-1 grid-cols-3 rounded-lg bg-neutral-100 p-1 text-[12.5px]">
        {stages.map((stage, index) => (
          <span class="relative z-10 py-1 text-center text-neutral-500">
            <span class="absolute inset-0 -z-10 rounded-md bg-white shadow-[0_1px_2px_rgba(0,0,0,0.08)]" data-at={[0, 3, 6][index]} data-until={[3, 6, 99][index]} data-fx="fade"></span>
            {stage}
          </span>
        ))}
      </div>
    </div>
    <ul class="mt-5 space-y-3 text-[13px] text-neutral-600">
      <li class="flex items-center gap-2.5"><Bot className="size-4 text-neutral-400" /> Drafted by Claude over MCP</li>
      <li class="flex items-center gap-2.5"><MessageSquare className="size-4 text-neutral-400" /> 1 comment from Jess</li>
      <li class="flex items-center gap-2.5"><Globe className="size-4 text-neutral-400" /> acme-roofing.com</li>
    </ul>
  </div>
  <!-- Entry -->
  <div class="p-6">
    <div class="flex items-baseline gap-2 text-[13px]">
      <span class="font-semibold text-neutral-900">Services</span><span class="text-neutral-400">Emergency roof repair</span>
    </div>
    <h4 class="mt-5 font-logo text-[28px] leading-tight tracking-tight text-neutral-900">Emergency roof repair</h4>
    <dl class="mt-5 grid grid-cols-[92px_1fr] items-center gap-x-3 gap-y-2.5 text-[12.5px]">
      <dt class="text-neutral-400">Price from</dt>
      <dd class="flex items-center gap-2">
        <span class="rounded bg-rose-50 px-1.5 py-0.5 text-rose-700" data-at="2" data-fx="fade">$219</span>
        <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-emerald-800">$249</span>
      </dd>
      <dt class="text-neutral-400">Hours</dt>
      <dd><span class="rounded bg-neutral-100 px-1.5 py-0.5 text-neutral-700">Open 24/7</span></dd>
      <dt class="text-neutral-400">Areas</dt>
      <dd class="flex gap-1">
        {['Austin', 'Round Rock', 'Cedar Park'].map((area) => <span class="rounded bg-sky-50 px-1.5 py-0.5 text-sky-800">{area}</span>)}
      </dd>
    </dl>
    <p class="mt-6 border-t border-neutral-100 pt-5 font-logo text-[15px] leading-relaxed text-neutral-700">
      A leak after a storm can’t wait for Monday.
      <span class="rounded-sm bg-lime-100 text-neutral-900" data-type data-at="1" data-fx="fade" data-text=" Crews are on site within 60 minutes, day or night."></span>
    </p>
    <p class="mt-3 font-logo text-[15px] leading-relaxed text-neutral-300">Every repair is photographed for your insurer, and…</p>
  </div>
</div>
