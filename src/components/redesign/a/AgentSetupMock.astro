---
// Agentic onboarding: the setup prompt is pasted into a coding agent, which
// runs create-gitcms, commits `.gitcms`, and hands back the link that adds
// the site in GitCMS. CLI lines mirror packages/create-gitcms output for a
// single Astro site at the repository root. The agent tabs only change the
// terminal's chrome; the prompt is the same for every agent.
import { GitCMSLogo } from '@/components/gitcms-logo'
import Cursor from '@/components/redesign/mock/Cursor.astro'
import { SETUP_CLI_COMMAND } from '@/lib/agent-setup-prompt'

const agents = [
  { key: 'claude', label: 'Claude Code', logo: '/ai-logos/claude-orange.svg', invert: false },
  { key: 'codex', label: 'Codex', logo: '/ai-logos/openai-bw.svg', invert: true },
  { key: 'cursor', label: 'Cursor', logo: '/ai-logos/cursor.svg', invert: true },
  { key: 'opencode', label: 'OpenCode', logo: '/ai-logos/opencode.svg', invert: true },
] as const
const promptHead = 'Set up GitCMS for this repository so my team can edit its content.'
const collections = ['Pages', 'Services', 'Blog', 'Locations']
const dim = 'text-neutral-500'
---
<div data-agent-setup class="relative">
  <div class="mb-3 flex flex-wrap gap-1.5" role="tablist" aria-label="Coding agent">
    {agents.map((agent, index) => (
      <button type="button" role="tab" data-agent-tab={agent.key} data-label={agent.label} data-logo={agent.logo} data-invert={String(agent.invert)} aria-selected={index === 0 ? 'true' : 'false'} class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1 text-[12px] font-medium text-neutral-500 transition-colors aria-selected:border-neutral-900 aria-selected:text-neutral-900">
        <img src={agent.logo} alt="" class="size-3.5" /> {agent.label}
      </button>
    ))}
  </div>

  <div data-seq="10" data-final="8" data-ms="1300" class="relative flex h-[440px] flex-col overflow-hidden rounded-xl bg-[#121212] font-mono text-[10px] leading-[1.55] text-neutral-200 sm:text-[11.5px] sm:leading-[1.6]">
    <div class="flex h-9 shrink-0 items-center gap-2 border-b border-white/10 px-3 text-[11px] text-neutral-400">
      <span class="flex gap-1.5"><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span></span>
      <img data-agent-logo src={agents[0].logo} alt="" class="ml-2 size-3.5" />
      <span data-agent-label class="text-neutral-200">{agents[0].label}</span>
      <span>· ~/acme/roofing-site</span>
    </div>

    <div class="min-h-0 flex-1 space-y-2 overflow-hidden px-4 py-3">
      <div class="rounded-md bg-white/5 px-2 py-1 text-neutral-300" data-at="2"><span class={dim}>&gt;</span> {promptHead} <span class={dim}>[Pasted text +5 lines]</span></div>
      <div data-at="2" data-fx="fade"><span class="text-emerald-400">⏺</span> Bash(<span class="text-white">{SETUP_CLI_COMMAND} --yes</span>)</div>
      <div class:list={['border-l border-white/10 pl-3', dim]} data-at="3">
        <div>Mode: single</div>
        <div>Sites: 1</div>
        <div class="text-neutral-300">- .gitcms/sites/site/config.jsonc</div>
        <div>&nbsp; framework: <span class="text-neutral-300">astro</span></div>
        <div>&nbsp; website_url: <span class="text-neutral-300">https://acme-roofing.com</span></div>
        <div>&nbsp; collections: <span class="text-neutral-300">4 (high)</span></div>
      </div>
      <div class:list={['border-l border-white/10 pl-3', dim]} data-at="4">
        <div class="text-emerald-400">Initialization complete.</div>
        <div>- .gitcms/sites/site/config.jsonc (created)</div>
      </div>
      <div data-at="5"><span class="text-emerald-400">⏺</span> Bash(<span class="text-white">git add .gitcms &amp;&amp; git commit -m "Set up GitCMS" &amp;&amp; git push</span>)</div>
      <div data-at="6"><span class="text-emerald-400">⏺</span> GitCMS is set up for acme-roofing.com. Open this link to finish adding the site:
        <span class="text-[#DCF986] underline decoration-[#DCF986]/40 underline-offset-2" data-cursor-at="6">app.gitcms.dev/acme/roofing-site?setup=add</span>
      </div>
    </div>

    <!-- Input box, like the agent's own composer: the prompt is pasted, then sent. -->
    <div class="m-3 mt-0 shrink-0 rounded-lg border border-white/15 px-3 py-2" data-cursor-at="0">
      <span class={dim}>&gt;</span>
      <span class="text-neutral-500" data-at="0" data-until="1" data-fx="collapse">Paste the setup prompt</span>
      <span class="text-neutral-200" data-at="1" data-until="2" data-fx="collapse">{promptHead} <span class={dim}>[Pasted text +5 lines]</span></span>
    </div>

    <!-- The link opens GitCMS with the site already configured from `.gitcms`. -->
    <div class="absolute inset-x-6 bottom-6 rounded-xl border border-neutral-200 bg-white p-4 font-sans text-neutral-800 shadow-[0_16px_40px_-16px_rgba(0,0,0,0.6)]" data-at="7">
      <div class="flex items-center gap-2 text-[13px] font-semibold">
        <GitCMSLogo className="size-5" /> acme-roofing.com is ready
        <span class="ml-auto rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">Site added</span>
      </div>
      <p class="mt-1 text-[12px] text-neutral-500">Read from <span class="font-mono text-[11px]">.gitcms</span> on main. Invite your client next.</p>
      <div class="mt-3 flex flex-wrap gap-1.5 text-[11.5px]">
        {collections.map((name) => <span class="rounded-md border border-neutral-200 px-2 py-0.5 text-neutral-600">{name}</span>)}
      </div>
    </div>
    <Cursor />
  </div>
</div>

<script>
  // Swap the terminal's agent chrome; the demo keeps playing.
  for (const root of document.querySelectorAll<HTMLElement>('[data-agent-setup]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-agent-tab]')]
    const logo = root.querySelector<HTMLImageElement>('[data-agent-logo]')
    const label = root.querySelector<HTMLElement>('[data-agent-label]')
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        tabs.forEach((other) => other.setAttribute('aria-selected', String(other === tab)))
        if (logo) {
          logo.src = tab.dataset.logo ?? ''
          logo.classList.toggle('invert', tab.dataset.invert === 'true')
        }
        if (label) label.textContent = tab.dataset.label ?? ''
      })
    }
  }
</script>
