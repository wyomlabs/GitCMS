---
interface Props {
  label?: string
  dark?: boolean
}
const { label = 'Coming soon', dark = false } = Astro.props
---
<span class:list={['inline-flex w-fit items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium', dark ? 'border-lime-300/30 bg-lime-300/10 text-lime-200' : 'border-lime-300 bg-lime-50 text-lime-800']}>
  <span class="size-1.5 rounded-full bg-lime-500"></span>{label}
</span>
