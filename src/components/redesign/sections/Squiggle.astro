---
// Hand-drawn underline for one phrase in a headline.
interface Props {
  class?: string
}
const { class: className = 'text-lime-500' } = Astro.props
---
<span class="relative inline-block whitespace-nowrap">
  <slot />
  <svg viewBox="0 0 300 14" preserveAspectRatio="none" class:list={['absolute -bottom-2 left-0 h-3 w-full', className]} aria-hidden="true">
    <path d="M2 9 C 25 2, 45 13, 70 7 S 115 2, 140 8 S 185 13, 210 6 S 260 3, 298 8" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
  </svg>
</span>
