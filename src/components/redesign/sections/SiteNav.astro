---
import { GitCMSLogo } from '@/components/gitcms-logo'
import { loginUrl } from '@/lib/start-login'

interface Props {
  variant?: 'plain' | 'floating'
}
const { variant = 'plain' } = Astro.props
const links = [
  { label: 'Product', href: '#product' },
  { label: 'Agents', href: '/agents' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Docs', href: '/docs/' },
  { label: 'Blog', href: '/blog' },
]
---
<header class:list={['sticky top-0 z-40', variant === 'floating' ? 'px-4 pt-3' : 'border-b border-neutral-200/70 bg-white/80 backdrop-blur-md']}>
  <div class:list={['mx-auto flex max-w-6xl items-center gap-6 px-5', variant === 'floating' ? 'h-14 rounded-2xl border border-neutral-200 bg-white/85 shadow-sm backdrop-blur-md' : 'h-16']}>
    <a href="/" class="flex items-center gap-2">
      <GitCMSLogo className="size-7" />
      <span class="font-logo text-[22px] font-medium tracking-tight">GitCMS</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-neutral-600 md:flex">
      {links.map((link) => <a href={link.href} class="transition-colors hover:text-neutral-900">{link.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-2 text-sm">
      <a href={loginUrl('/')} class="hidden px-3 py-2 text-neutral-700 hover:text-neutral-900 sm:inline">Sign in</a>
      <a href={loginUrl('/')} class="rounded-lg bg-neutral-900 px-3.5 py-2 font-medium text-white transition-colors hover:bg-neutral-800">Connect your site</a>
    </div>
  </div>
</header>
