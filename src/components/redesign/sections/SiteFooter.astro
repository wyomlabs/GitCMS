---
import { GitCMSLogo } from '@/components/gitcms-logo'
import { PRODUCT_DEFINITION } from '@/lib/positioning'
const columns = [
  { title: 'Product', links: [['Docs', '/docs/'], ['Changelog', '/changelog/'], ['Agents', '/agents/'], ['Free tools', '/tools/']] },
  { title: 'For', links: [['Agencies', '/for-agencies/'], ['Startups', '/for-startups/'], ['Freelancers', '/for-freelancers/'], ['Solo builders', '/for-solo-builders/']] },
  { title: 'Learn', links: [['Blog', '/blog/'], ['Compare', '/compare/'], ['Glossary', '/glossary/'], ['Prompts', '/prompts/']] },
  { title: 'Company', links: [['Manifesto', '/manifesto/'], ['Terms', '/terms/'], ['Privacy', '/privacy/']] },
] as const
---
<footer class="border-t border-neutral-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div>
      <a href="/" class="flex items-center gap-2"><GitCMSLogo className="size-6" /><span class="font-logo text-xl font-medium">GitCMS</span></a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-neutral-500">{PRODUCT_DEFINITION}</p>
    </div>
    {columns.map((column) => (
      <div>
        <div class="text-sm font-medium text-neutral-900">{column.title}</div>
        <ul class="mt-3 space-y-2 text-sm text-neutral-500">
          {column.links.map(([label, href]) => <li><a href={href} class="hover:text-neutral-900">{label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
</footer>
