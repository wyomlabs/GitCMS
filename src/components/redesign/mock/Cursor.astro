---
// Pointer that the Sequencer glides between `data-cursor-at` targets.
---
<span data-cursor aria-hidden="true">
  <span class="ring absolute -left-2.5 -top-2.5 block size-6 rounded-full bg-neutral-900/30"></span>
  <svg width="18" height="20" viewBox="0 0 18 20" class="relative drop-shadow-[0_1px_1.5px_rgba(0,0,0,0.25)]">
    <path d="M2 2 L2 16 L6 12.5 L8.6 18 L11 17 L8.5 11.6 L13.5 11.6 Z" fill="#111" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" />
  </svg>
</span>
