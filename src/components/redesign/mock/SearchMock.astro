---
// Search Console insights for a site: clicks over time, top queries mapped
// to entries, and an opportunity turned into a content task.
import { ArrowUpRight, Sparkles } from 'lucide-react'
import Cursor from './Cursor.astro'
import { SEARCH_QUERIES } from '../content'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const clicks = 'M0 62 C 30 58, 45 64, 70 52 S 120 40, 150 44 S 200 30, 230 28 S 280 18, 320 10'
const impressions = 'M0 48 C 40 44, 60 50, 90 40 S 150 34, 180 30 S 240 24, 270 18 S 300 14, 320 12'
---
<div data-seq="8" data-ms="1300" data-final="7" class:list={['relative flex h-full flex-col bg-white text-[12px]', className]}>
  <div class="flex items-center gap-2 border-b border-neutral-200 px-4 py-2.5">
    <span class="font-medium text-neutral-900">Search performance</span>
    <span class="rounded-full bg-neutral-100 px-1.5 py-0.5 text-[10px] text-neutral-500">Google Search Console</span>
    <span class="ml-auto rounded-md border border-neutral-200 px-1.5 py-0.5 text-[10.5px] text-neutral-500">Last 28 days</span>
  </div>
  <div class="grid grid-cols-3 gap-px border-b border-neutral-200 bg-neutral-200">
    {[['Clicks', '1,284', '+18%'], ['Impressions', '42.6k', '+9%'], ['Avg. position', '8.4', '−1.2']].map(([label, value, delta]) => (
      <div class="bg-white px-4 py-2">
        <div class="text-[10.5px] text-neutral-500">{label}</div>
        <div class="flex items-baseline gap-1.5"><span class="text-[17px] font-semibold tracking-tight">{value}</span><span class="text-[10.5px] text-emerald-600">{delta}</span></div>
      </div>
    ))}
  </div>
  <svg viewBox="0 0 320 72" class="h-20 w-full shrink-0 px-4 pt-2" preserveAspectRatio="none" aria-hidden="true">
    <path d={impressions} fill="none" stroke="#c4b5fd" stroke-width="1.5" class="rd-draw" data-at="0" data-fx="fade" style="--len: 400" />
    <path d={clicks} fill="none" stroke="#7c3aed" stroke-width="2" class="rd-draw" data-at="0" data-fx="fade" style="--len: 400" />
  </svg>
  <div class="flex-1 overflow-hidden px-4 pb-3">
    <div class="grid grid-cols-[1fr_44px_48px_44px] gap-2 border-b border-neutral-100 py-1.5 text-[10px] font-medium uppercase tracking-wide text-neutral-400">
      <span>Query</span><span class="text-right">Clicks</span><span class="text-right">Impr.</span><span class="text-right">Pos.</span>
    </div>
    {SEARCH_QUERIES.map((row, index) => (
      <div class:list={['grid grid-cols-[1fr_44px_48px_44px] items-center gap-2 border-b border-neutral-100 py-1.5', 'opportunity' in row && 'relative']} data-at={1 + index}>
        <span class="truncate text-neutral-800">{row.query}</span>
        <span class="text-right tabular-nums">{row.clicks}</span>
        <span class="text-right tabular-nums text-neutral-500">{row.impressions}</span>
        <span class:list={['text-right tabular-nums', 'opportunity' in row ? 'font-semibold text-amber-600' : 'text-neutral-500']}>{row.position}</span>
      </div>
    ))}
    <div class="mt-2.5 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50/70 p-2.5" data-at="5">
      <Sparkles className="mt-0.5 size-3.5 shrink-0 text-amber-600" />
      <div class="min-w-0 flex-1 text-[11.5px] leading-snug text-neutral-700">
        <span class="font-medium text-neutral-900">“metal roof cost texas”</span> gets 5.9k impressions but sits on page two. <span class="text-neutral-500">Blog › Metal roof cost guide</span>
      </div>
      <span data-cursor-at="6" class="inline-flex shrink-0 items-center gap-1 rounded-md bg-neutral-900 px-2 py-1 text-[10.5px] font-medium text-white">
        <span data-at="7" data-fx="collapse">#58 created</span>
        <span data-at="0" data-until="7" data-fx="collapse">Create task</span>
        <ArrowUpRight className="size-3" />
      </span>
    </div>
  </div>
  <Cursor />
</div>
