---
// Content board (DESIGN.md "Board"): tinted workflow columns. One content
// task, drafted by an agent, moves through Draft → Review → Published.
import { MessageSquare } from 'lucide-react'

const columns = [
  { name: 'Ideas', dot: 'bg-amber-400', head: 'bg-amber-50/80 border-amber-100', count: 3 },
  { name: 'Draft', dot: 'bg-sky-500', head: 'bg-sky-50/80 border-sky-100', count: 2 },
  { name: 'Review', dot: 'bg-violet-500', head: 'bg-violet-50/80 border-violet-100', count: 1 },
  { name: 'Published', dot: 'bg-emerald-500', head: 'bg-emerald-50/80 border-emerald-100', count: 8 },
] as const

const staticCards: Record<string, Array<{ title: string; id: number; who: string }>> = {
  Ideas: [
    { title: 'Spring storm checklist', id: 51, who: 'Jess' },
    { title: 'Metal roof cost guide', id: 53, who: 'Claude' },
  ],
  Draft: [{ title: 'New Round Rock location page', id: 48, who: 'Sam' }],
  Review: [],
  Published: [
    { title: 'Hail damage FAQ', id: 39, who: 'Jess' },
    { title: 'Warranty page refresh', id: 37, who: 'Claude' },
  ],
}
// Where the moving card sits at each step: [column, fromStep, untilStep]
const moving = [
  ['Draft', 1, 3],
  ['Review', 3, 6],
  ['Published', 6, 9],
] as const
---
<div class="grid h-full grid-cols-4 gap-2 p-3">
  {columns.map((column) => (
    <div class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-neutral-50/40">
      <div class:list={['flex items-center gap-1.5 rounded-t-lg border-b px-2 py-1.5 text-[11px] font-medium', column.head]}>
        <span class:list={['size-1.5 rounded-full', column.dot]}></span>
        {column.name}
        <span class="ml-auto rounded-full border border-current/10 bg-white px-1.5 text-[10px] text-neutral-500">{column.count}</span>
      </div>
      <div class="flex flex-col gap-1.5 p-1.5">
        {moving.filter(([name]) => name === column.name).map(([, from, until]) => (
          <div data-at={from} data-until={until} data-fx="collapse" class="rounded-md border border-violet-300 bg-white p-2 ring-2 ring-violet-100">
            <div class="text-[11px] font-medium leading-snug text-neutral-900">Q4 pricing update</div>
            <div class="mt-1 flex items-center gap-1 text-[10px] text-neutral-500">
              <span class="rounded border border-neutral-200 px-1 font-medium text-neutral-700">#57</span>
              <img src="/ai-logos/claude-orange.svg" alt="" class="size-3" /> Claude
            </div>
            {column.name === 'Review' && (
              <div class="mt-1.5 flex items-center gap-1 rounded bg-violet-50 px-1.5 py-1 text-[10px] text-violet-700" data-at="4" data-fx="fade">
                <MessageSquare className="size-3" /> Jess: “Say 24/7 here”
              </div>
            )}
          </div>
        ))}
        {column.name === 'Ideas' && (
          <div data-at="0" data-until="1" data-fx="collapse" class="rounded-md border border-neutral-200 bg-white p-2">
            <div class="text-[11px] font-medium leading-snug text-neutral-900">Q4 pricing update</div>
            <div class="mt-1 text-[10px] text-neutral-500"><span class="rounded border border-neutral-200 px-1 font-medium text-neutral-700">#57</span> Idea</div>
          </div>
        )}
        {staticCards[column.name]?.map((card) => (
          <div class="rounded-md border border-neutral-200 bg-white p-2">
            <div class="text-[11px] font-medium leading-snug text-neutral-800">{card.title}</div>
            <div class="mt-1 text-[10px] text-neutral-500"><span class="rounded border border-neutral-200 px-1 font-medium text-neutral-700">#{card.id}</span> {card.who}</div>
          </div>
        ))}
        {column.name === 'Review' && (
          <div data-at="0" data-until="3" data-fx="collapse" class="grid h-12 place-items-center rounded-md border border-dashed border-neutral-200 text-[10px] text-neutral-400">Drop cards here</div>
        )}
      </div>
    </div>
  ))}
</div>
