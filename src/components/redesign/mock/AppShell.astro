---
// The CMS frame from apps/web: sidebar with collections, top bar with the
// site switcher breadcrumb and page actions. Mirrors DESIGN.md "Layout".
import { BookOpen, FileText, Folder, LayoutGrid, MapPin, Newspaper, Settings, SlidersHorizontal, Wrench } from 'lucide-react'
import { GitCMSLogo } from '@/components/gitcms-logo'

interface Props {
  active?: 'Pages' | 'Services' | 'Blog' | 'Locations' | 'Media' | 'Content board'
  crumbs?: string[]
  site?: string
  class?: string
  /** Narrower sidebar for tight spots like the hero. */
  compact?: boolean
}
const { active = 'Services', crumbs = [], site = 'acme-roofing.com', class: className = '', compact = false } = Astro.props

const collections = [
  { label: 'Pages', icon: FileText },
  { label: 'Services', icon: Wrench },
  { label: 'Blog', icon: Newspaper },
  { label: 'Locations', icon: MapPin },
] as const
const tools = [
  { label: 'Media', icon: Folder },
  { label: 'Content board', icon: LayoutGrid },
  { label: 'Configure', icon: SlidersHorizontal },
] as const
---
<div class:list={['flex h-full min-h-0 text-[12px] text-neutral-800', className]}>
  <aside class:list={['hidden shrink-0 flex-col border-r border-neutral-200 bg-neutral-50/80 sm:flex', compact ? 'w-[132px]' : 'w-[168px]']}>
    <div class="flex items-center gap-1.5 px-3 pb-2 pt-3">
      <GitCMSLogo className="size-5" />
      <span class="font-logo text-[15px] font-medium tracking-tight">GitCMS</span>
    </div>
    <div class="px-2 pb-1 text-[10px] font-medium text-neutral-400">Collections</div>
    <nav class="flex flex-col gap-px px-1.5">
      {collections.map(({ label, icon: Icon }) => (
        <span class:list={['flex items-center gap-2 rounded-md px-2 py-1', active === label ? 'border border-neutral-200 bg-white font-medium' : 'text-neutral-600']}>
          <Icon className="size-3.5" /> {label}
        </span>
      ))}
    </nav>
    <div class="mx-2 my-2 border-t border-neutral-200"></div>
    <nav class="flex flex-col gap-px px-1.5">
      {tools.map(({ label, icon: Icon }) => (
        <span class:list={['flex items-center gap-2 rounded-md px-2 py-1', active === label ? 'border border-neutral-200 bg-white font-medium' : 'text-neutral-600']}>
          <Icon className="size-3.5" /> {label}
        </span>
      ))}
    </nav>
    <div class="mt-auto p-2">
      <div class="flex items-center gap-2 rounded-md border border-neutral-200 bg-white p-1.5">
        <span class="grid size-5 place-items-center rounded-full bg-neutral-900 text-[9px] font-semibold text-white">J</span>
        <div class="min-w-0 leading-tight">
          <div class="truncate text-[11px] font-medium">Jess Carter</div>
          <div class="truncate text-[10px] text-neutral-400">Acme Roofing</div>
        </div>
        <Settings className="ml-auto size-3 text-neutral-400" />
      </div>
    </div>
  </aside>
  <div class="flex min-w-0 flex-1 flex-col">
    <header class="flex h-10 shrink-0 items-center gap-2 border-b border-neutral-200 px-3">
      <BookOpen className="size-3.5 text-neutral-400" />
      <span class="flex min-w-0 items-center gap-1.5 truncate text-neutral-500">
        <span class="grid size-3.5 shrink-0 place-items-center rounded-[3px] bg-amber-500 text-[8px] font-bold uppercase text-white">{site[0]}</span>
        <span>{site}</span>
        {crumbs.map((crumb, index) => (
          <>
            <span class="text-neutral-300">›</span>
            <span class:list={[index === crumbs.length - 1 && 'text-neutral-900']}>{crumb}</span>
          </>
        ))}
      </span>
      <div class="ml-auto flex shrink-0 items-center gap-1.5 whitespace-nowrap">
        <slot name="actions" />
      </div>
    </header>
    <div class="relative min-h-0 flex-1 overflow-hidden">
      <slot />
    </div>
  </div>
  <!-- Docked side panel: full height beside the header (DESIGN.md "Side panel"). -->
  <slot name="panel" />
</div>
