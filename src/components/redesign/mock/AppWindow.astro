---
// Browser chrome around an app mockup.
interface Props {
  url?: string
  class?: string
  dark?: boolean
}
const { url = 'app.gitcms.dev', class: className = '', dark = false } = Astro.props
---
<div
  class:list={[
    'overflow-hidden rounded-xl border',
    dark ? 'border-neutral-800 bg-neutral-900' : 'border-neutral-200 bg-white',
    className,
  ]}
>
  <div class:list={['flex h-9 items-center gap-3 border-b px-3', dark ? 'border-neutral-800' : 'border-neutral-200 bg-neutral-50']}>
    <div class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-neutral-300"></span>
      <span class="size-2.5 rounded-full bg-neutral-300"></span>
      <span class="size-2.5 rounded-full bg-neutral-300"></span>
    </div>
    <div data-window-url class:list={['mx-auto min-w-0 max-w-[70%] truncate rounded-md px-3 py-0.5 text-[11px]', dark ? 'bg-neutral-800 text-neutral-400' : 'border border-neutral-200 bg-white text-neutral-500']}>
      {url}
    </div>
    <div class="w-10"></div>
  </div>
  <slot />
</div>
