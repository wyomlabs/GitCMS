---
// Black Friday popup on every marketing page. It opens by itself once per
// campaign, after a short read or some scrolling, and any time from the deal
// button pinned bottom left (the Discord support button's twin on the
// right). Neither shows after the sale ends. A native <dialog> gives focus
// trapping, Esc and a backdrop; on phones it is a bottom sheet, within thumb
// reach.
import { ArrowRight, Tag, X } from 'lucide-react'
import Countdown from './Countdown.astro'
import { BLACK_FRIDAY } from '@/lib/promo'
import { loginUrl } from '@/lib/start-login'
import { heading } from '@/components/site/styles'

const { sitePrice, seatPrice, teamPlanName, teamYearly } = BLACK_FRIDAY

// The header is a commit graph in place of an illustration: main runs along
// the bottom, a branch forks off and merges back, and the last commit, the
// one that ships, is lime.
const MAIN_Y = 176
const BRANCH_Y = 146
const mainCommits = [24, 78, 132, 296, 350, 404]
const branchCommits = [186, 242]
// Pixel sparkles, as [x, y] of each plus sign's centre.
const sparkles = [[44, 34], [404, 96], [70, 112]]
---
<dialog data-promo="popup" aria-label="Black Friday offer" tabindex="-1" class="promo-dialog">
  <div class="relative w-[min(440px,calc(100vw-2rem))] overflow-hidden rounded-3xl bg-white text-neutral-900 shadow-2xl max-sm:w-screen max-sm:rounded-b-none">
    <button type="button" data-promo-close aria-label="Close" class="absolute right-3 top-3 z-10 grid size-8 place-items-center rounded-full border border-white/15 bg-neutral-950/60 text-neutral-300 transition-colors hover:bg-white/10 hover:text-white"><X className="size-4" /></button>
    <div class="relative h-[204px] overflow-hidden bg-neutral-950">
      <svg aria-hidden="true" viewBox="0 0 440 204" class="absolute inset-0 size-full" preserveAspectRatio="xMidYMax meet">
        <path d={`M0 ${MAIN_Y} H440`} stroke="rgb(255 255 255 / 0.22)" stroke-width="3" fill="none" />
        <path d={`M132 ${MAIN_Y} C160 ${MAIN_Y} 160 ${BRANCH_Y} 186 ${BRANCH_Y} H242 C270 ${BRANCH_Y} 270 ${MAIN_Y} 296 ${MAIN_Y}`} stroke="#DCF986" stroke-opacity="0.55" stroke-width="3" fill="none" />
        {mainCommits.map((x, index) => index === mainCommits.length - 1
          ? <g><circle cx={x} cy={MAIN_Y} r="13" fill="#DCF986" fill-opacity="0.18" /><circle cx={x} cy={MAIN_Y} r="7" fill="#DCF986" /></g>
          : <circle cx={x} cy={MAIN_Y} r="6" fill="#0a0a0a" stroke="rgb(255 255 255 / 0.5)" stroke-width="3" />)}
        {branchCommits.map((x) => <circle cx={x} cy={BRANCH_Y} r="6" fill="#0a0a0a" stroke="#DCF986" stroke-width="3" />)}
        {sparkles.map(([x, y]) => <path d={`M${x - 2} ${y - 8}h4v6h6v4h-6v6h-4v-6h-6v-4h6z`} fill="#DCF986" fill-opacity="0.8" />)}
      </svg>
      <div class="relative flex flex-col items-center pt-7 text-center">
        <div class:list={['text-[40px] leading-none text-white sm:text-[44px]', heading]}>Black Friday</div>
        <div class="mt-3 rounded-full bg-[#DCF986] px-3.5 py-1 text-[13px] font-medium text-neutral-950">ends in <Countdown /></div>
      </div>
    </div>
    <div class="px-6 pb-6 pt-6 sm:px-7">
      <h2 class:list={['text-[26px] leading-tight', heading]}>${sitePrice} once per site, forever</h2>
      <p class="mt-1 text-[14px] text-neutral-500">The last one-time license before GitCMS goes monthly</p>
      <div class="mt-5 flex items-center justify-between gap-4 rounded-2xl border-2 border-dashed border-neutral-200 px-5 py-4">
        <div>
          <div class="text-[12px] text-neutral-500">{teamPlanName} plan, first year</div>
          <div class="mt-0.5 text-[22px] font-semibold tracking-tight text-neutral-400 line-through decoration-neutral-400/70">${teamYearly}</div>
        </div>
        <ArrowRight className="size-4 shrink-0 text-neutral-300" />
        <div class="text-right">
          <div class="text-[12px] text-neutral-500">Founding license</div>
          <div class="mt-0.5 text-[22px] font-semibold tracking-tight">${sitePrice} <span class="text-[13px] font-normal text-neutral-500">once</span></div>
        </div>
      </div>
      <a href={loginUrl('/')} class="mt-5 flex h-12 w-full items-center justify-center gap-2 rounded-full bg-neutral-950 text-[15px] font-medium text-white hover:bg-neutral-800">Get the founding license <ArrowRight className="size-4" /></a>
      <p class="mt-3 text-center text-[12px] text-neutral-500">${seatPrice} per extra seat · every future update included</p>
    </div>
  </div>
</dialog>
<!-- Hidden until the script knows the sale is still on. Below `sm` it shrinks to the icon, like the Discord button. -->
<button
  type="button"
  data-promo-opener
  hidden
  aria-label="Black Friday deal"
  class="fixed bottom-4 left-4 z-40 inline-flex items-center gap-2.5 rounded-full border border-neutral-200 bg-white p-3.5 text-sm font-semibold text-neutral-900 shadow-lg shadow-neutral-900/10 transition-all hover:-translate-y-0.5 hover:border-neutral-300 hover:shadow-xl motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:bottom-6 sm:left-6 sm:px-5 sm:py-3"
>
  <span class="relative grid size-5 place-items-center">
    <Tag className="size-5" />
    <span class="absolute -right-0.5 -top-0.5 size-2 rounded-full bg-[#DCF986] ring-2 ring-white"></span>
  </span>
  <span class="hidden sm:inline">Black Friday deal</span>
</button>

<script>
  import { BLACK_FRIDAY } from '@/lib/promo'

  const seenKey = `gitcms:${BLACK_FRIDAY.id}:popup`
  // Wait for some intent before interrupting: a short read or a third of the page.
  const DELAY_MS = 12_000
  const SCROLL_SHARE = 0.35

  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-promo="popup"]')
  const opener = document.querySelector<HTMLButtonElement>('[data-promo-opener]')
  if (dialog && opener && Date.now() < Date.parse(BLACK_FRIDAY.endsAt)) {
    const open = () => {
      if (dialog.open) return
      dialog.showModal()
      // The browser focuses the first control, the close button; hold focus
      // on the dialog so nothing opens ringed. Tab still reaches every control.
      dialog.focus()
    }
    for (const button of dialog.querySelectorAll('[data-promo-close]')) {
      button.addEventListener('click', () => dialog.close())
    }
    // A click on the backdrop lands on the dialog itself, outside the card.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    opener.hidden = false
    opener.addEventListener('click', open)

    // The automatic open happens once per campaign; closing it, however it
    // was opened, counts as seen.
    if (!localStorage.getItem(seenKey)) {
      dialog.addEventListener('close', () => localStorage.setItem(seenKey, '1'), { once: true })
      const autoOpen = () => {
        window.removeEventListener('scroll', onScroll)
        clearTimeout(timer)
        open()
      }
      const onScroll = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight
        if (scrollable > 0 && window.scrollY / scrollable > SCROLL_SHARE) autoOpen()
      }
      const timer = setTimeout(autoOpen, DELAY_MS)
      window.addEventListener('scroll', onScroll, { passive: true })
      dialog.addEventListener('close', () => {
        window.removeEventListener('scroll', onScroll)
        clearTimeout(timer)
      }, { once: true })
    }
  }
</script>

<style>
  .promo-dialog {
    outline: none;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    max-width: none;
    max-height: none;
  }
  .promo-dialog::backdrop {
    background: rgb(10 10 10 / 0.55);
    backdrop-filter: blur(4px);
  }
  .promo-dialog[open] { animation: promo-in 260ms cubic-bezier(0.22, 1, 0.36, 1); }
  .promo-dialog[open]::backdrop { animation: promo-fade 200ms ease-out; }
  /* On phones the card is a bottom sheet that rises into place. */
  @media (max-width: 639px) {
    .promo-dialog { margin: auto 0 0; }
    .promo-dialog[open] { animation: promo-rise 320ms cubic-bezier(0.22, 1, 0.36, 1); }
  }
  @keyframes promo-in { from { opacity: 0; transform: translateY(8px) scale(0.97); } }
  @keyframes promo-rise { from { opacity: 0; transform: translateY(16px); } }
  @keyframes promo-fade { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .promo-dialog[open], .promo-dialog[open]::backdrop { animation: promo-fade 150ms ease-out; }
  }
</style>
