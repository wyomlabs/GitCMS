---
// Black Friday card at the top of the page column, under the floating header
// and as wide as the hero card. It sits in the page flow, so it scrolls away
// like any section. A dismissal is remembered per campaign and applied by an
// inline script straight after the markup, so a dismissed card never flashes.
import { ArrowRight, X } from 'lucide-react'
import Countdown from './Countdown.astro'
import { BLACK_FRIDAY } from '@/lib/promo'
import { loginUrl } from '@/lib/start-login'
import { heading } from '@/components/site/styles'

const dismissedKey = `gitcms:${BLACK_FRIDAY.id}:banner`
// Faint commit-graph strips at both ends, the popup's motif. The right one
// ends in the lime commit that ships.
const Y = 28
const leftCommits = [20, 64, 108]
const rightCommits = [52, 96, 140]
---
<div data-promo="banner" class="px-3 pt-2">
  <div class="relative flex min-h-14 items-center overflow-hidden rounded-2xl bg-neutral-950 py-2.5 pl-3 pr-10 text-[13px] text-white sm:px-12">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 left-1/2 h-32 w-[480px] -translate-x-1/2 rounded-full bg-[#DCF986]/15 blur-3xl"></div>
    <svg aria-hidden="true" viewBox="0 0 160 56" class="absolute left-0 top-0 hidden h-full w-40 lg:block">
      <path d={`M0 ${Y} H160`} stroke="rgb(255 255 255 / 0.12)" stroke-width="2" />
      {leftCommits.map((x) => <circle cx={x} cy={Y} r="4" fill="#0a0a0a" stroke="rgb(255 255 255 / 0.25)" stroke-width="2" />)}
    </svg>
    <svg aria-hidden="true" viewBox="0 0 160 56" class="absolute right-10 top-0 hidden h-full w-40 lg:block">
      <path d={`M0 ${Y} H140`} stroke="rgb(255 255 255 / 0.12)" stroke-width="2" />
      {rightCommits.map((x, index) => index === rightCommits.length - 1
        ? <circle cx={x} cy={Y} r="5" fill="#DCF986" fill-opacity="0.7" />
        : <circle cx={x} cy={Y} r="4" fill="#0a0a0a" stroke="rgb(255 255 255 / 0.25)" stroke-width="2" />)}
    </svg>

    <div class="relative mx-auto flex min-w-0 items-center gap-2.5 sm:gap-4">
      <span class:list={['shrink-0 text-[17px] leading-none text-white sm:text-[19px]', heading]}>Black Friday</span>
      <span class="shrink-0 rounded-md bg-[#DCF986] px-2 py-1 text-[13px] font-semibold leading-none text-neutral-950">${BLACK_FRIDAY.sitePrice} once<span class="hidden sm:inline"> per site</span></span>
      <span class="hidden min-w-0 truncate text-neutral-400 md:inline">the last one-time license<span class="hidden xl:inline"> · agencies: <span class="text-neutral-200">{BLACK_FRIDAY.agency.percentOff}% off {BLACK_FRIDAY.agency.minSites}+ sites with <span class="font-mono text-[#DCF986]">{BLACK_FRIDAY.agency.code}</span></span></span> · ends in <span class="text-neutral-200"><Countdown /></span></span>
      <a href={loginUrl('/')} data-umami-event="bf-cta" data-umami-event-placement="banner" class="inline-flex h-8 shrink-0 items-center gap-1.5 rounded-full bg-white px-3 text-[13px] font-semibold text-neutral-950 transition-colors hover:bg-neutral-200 sm:px-3.5"><span>Get <span class="hidden sm:inline">the deal</span><span class="sm:hidden">it</span></span> <ArrowRight className="size-3.5" /></a>
    </div>
    <button type="button" data-promo-dismiss data-umami-event="bf-banner-dismiss" aria-label="Dismiss" class="absolute right-2 top-1/2 grid size-7 -translate-y-1/2 sm:right-3 place-items-center rounded-md text-neutral-500 transition-colors hover:bg-white/10 hover:text-white"><X className="size-4" /></button>
  </div>
</div>
<script is:inline define:vars={{ dismissedKey, endsAt: BLACK_FRIDAY.endsAt }}>
  if (localStorage.getItem(dismissedKey) || Date.now() >= Date.parse(endsAt)) {
    document.querySelector('[data-promo="banner"]').hidden = true
  }
</script>

<script>
  import { BLACK_FRIDAY } from '@/lib/promo'

  const banner = document.querySelector<HTMLElement>('[data-promo="banner"]')
  banner?.querySelector('[data-promo-dismiss]')?.addEventListener('click', () => {
    banner.hidden = true
    localStorage.setItem(`gitcms:${BLACK_FRIDAY.id}:banner`, '1')
  })
</script>
