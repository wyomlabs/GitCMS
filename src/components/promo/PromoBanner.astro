---
// Black Friday card at the top of the page column, under the floating header
// and as wide as the hero card. It sits in the page flow, so it scrolls away
// like any section, and it can't be dismissed. An inline script straight
// after the markup hides it once the sale has ended, before it can paint.
import { ArrowRight } from 'lucide-react'
import { BLACK_FRIDAY } from '@/lib/promo'
import { loginUrl } from '@/lib/start-login'
import { heading } from '@/components/site/styles'

// Faint commit-graph strips at both ends, the popup's motif. The right one
// ends in the lime commit that ships.
const Y = 28
const leftCommits = [20, 64]
const rightCommits = [96, 140]
---
<div data-promo="banner" class="px-3 pt-2">
  <div class="relative flex min-h-14 items-center overflow-hidden rounded-2xl bg-neutral-950 px-3 py-2.5 text-[13px] text-white sm:px-12">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 left-1/2 h-32 w-[480px] -translate-x-1/2 rounded-full bg-[#DCF986]/15 blur-3xl"></div>
    <svg aria-hidden="true" viewBox="0 0 160 56" class="absolute left-0 top-0 hidden h-full w-40 lg:block">
      <path d={`M0 ${Y} H160`} stroke="rgb(255 255 255 / 0.12)" stroke-width="2" />
      {leftCommits.map((x) => <circle cx={x} cy={Y} r="4" fill="#0a0a0a" stroke="rgb(255 255 255 / 0.25)" stroke-width="2" />)}
    </svg>
    <svg aria-hidden="true" viewBox="0 0 160 56" class="absolute right-0 top-0 hidden h-full w-40 lg:block">
      <path d={`M0 ${Y} H140`} stroke="rgb(255 255 255 / 0.12)" stroke-width="2" />
      {rightCommits.map((x, index) => index === rightCommits.length - 1
        ? <circle cx={x} cy={Y} r="5" fill="#DCF986" fill-opacity="0.7" />
        : <circle cx={x} cy={Y} r="4" fill="#0a0a0a" stroke="rgb(255 255 255 / 0.25)" stroke-width="2" />)}
    </svg>

    <div class="relative mx-auto flex min-w-0 items-center gap-2.5 sm:gap-4">
      <span class:list={['shrink-0 text-[17px] leading-none text-white sm:text-[19px]', heading]}>Black Friday</span>
      <span class="shrink-0 rounded-md bg-[#DCF986] px-2 py-1 text-[13px] font-semibold leading-none text-neutral-950">${BLACK_FRIDAY.sitePrice}<span class="hidden sm:inline">/site</span> once</span>
      <span class="hidden min-w-0 truncate text-neutral-400 md:inline">{BLACK_FRIDAY.agency.minSites}+ sites: <span class="text-neutral-200">{BLACK_FRIDAY.agency.percentOff}% off with <span class="font-mono text-[#DCF986]">{BLACK_FRIDAY.agency.code}</span></span></span>
      <a href={loginUrl('/')} data-umami-event="bf-cta" data-umami-event-placement="banner" class="inline-flex h-8 shrink-0 items-center gap-1.5 rounded-full bg-white px-3 text-[13px] font-semibold text-neutral-950 transition-colors hover:bg-neutral-200 sm:px-3.5"><span>Get <span class="hidden sm:inline">the deal</span><span class="sm:hidden">it</span></span> <ArrowRight className="size-3.5" /></a>
    </div>
  </div>
</div>
<script is:inline define:vars={{ endsAt: BLACK_FRIDAY.endsAt }}>
  if (Date.now() >= Date.parse(endsAt)) {
    document.querySelector('[data-promo="banner"]').hidden = true
  }
</script>
