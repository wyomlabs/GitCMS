---
// Agency workspace: every client site with its state at a glance.
import { Plus } from 'lucide-react'
import { GitCMSLogo } from '@/components/gitcms-logo'
import { FLEET } from '@/lib/site-content'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const tones: Record<string, string> = {
  emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  violet: 'bg-violet-50 text-violet-700 border-violet-200',
  sky: 'bg-sky-50 text-sky-700 border-sky-200',
}
---
<div class:list={['flex h-full flex-col bg-white text-[12px]', className]}>
  <div class="flex items-center gap-2 border-b border-neutral-200 px-4 py-2.5">
    <GitCMSLogo className="size-4" />
    <span class="font-medium text-neutral-900">Brightside Studio</span>
    <span class="text-neutral-400">· 12 sites · 31 people · 4 waiting for review</span>
    <span class="ml-auto inline-flex items-center gap-1 rounded-md bg-neutral-900 px-2 py-1 text-[10.5px] font-medium text-white"><Plus className="size-3" /> Add site</span>
  </div>
  <div class="flex-1 divide-y divide-neutral-100 overflow-hidden px-2">
    {FLEET.map((row) => (
      <div class="flex items-center gap-3 px-2 py-2">
        <span class="grid size-6 place-items-center rounded-md border border-neutral-200 bg-neutral-50 text-[10px] font-semibold uppercase text-neutral-500">{row.site[0]}</span>
        <span class="font-medium text-neutral-900">{row.site}</span>
        <span class:list={['rounded-full border px-1.5 py-px text-[10px] font-medium', tones[row.tone]]}>{row.status}</span>
        <span class="ml-auto text-[11px] text-neutral-500">{row.note}</span>
      </div>
    ))}
  </div>
</div>
