---
// The site's SEO page (the app's `/sites/$site/search`): search
// opportunities from Google Search Console or Bing Webmaster Tools, grouped by
// page. The cursor picks two searches and adds them to Ideas; the button
// itself says what happened.
import { Check, ChevronDown, Search, TrendingUp } from 'lucide-react'
import Cursor from './Cursor.astro'
import { SEO_OPPORTUNITIES, SEO_OPPORTUNITY_FILTERS } from '@/lib/site-content'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props

const problemTone: Record<string, string> = {
  'Near page one': 'bg-amber-50 text-amber-700',
  'Few clicks': 'bg-sky-50 text-sky-700',
  Question: 'bg-violet-50 text-violet-700',
  'No page': 'bg-neutral-100 text-neutral-600',
}
// The searches the cursor ticks, in order, each one step before it shows
// ticked. The last count stays up through the click on Add (step `addAt`).
const picks = ['metal roof cost texas', '24 hour roofer austin']
// A beat to read the table first; the rows themselves are there from the start.
const firstPick = 2
const addAt = firstPick + picks.length
const columns = 'grid grid-cols-[16px_1fr_104px_60px_80px_52px] items-center gap-3'
---
<div data-seq={addAt + 1} data-final={addAt + 1} data-ms="1000" data-hold={`${addAt + 1}:2200`} class:list={['relative flex h-full flex-col bg-white text-[12px]', className]}>
  <div class="flex items-center gap-2 border-b border-neutral-200 px-4 py-2.5">
    <TrendingUp className="size-4 text-neutral-500" />
    <span class="font-medium text-neutral-900">SEO</span>
    <!-- The app's search source switch: one engine at a time, never summed. -->
    <span class="ml-auto inline-flex items-center rounded-md bg-neutral-100 p-0.5 text-[10.5px]">
      {[['Google', '/logos/google.svg'], ['Bing', '/logos/bing.svg']].map(([engine, logo], index) => (
        <span class:list={['inline-flex items-center gap-1 rounded px-2 py-0.5', index === 0 ? 'bg-white font-medium text-neutral-900 shadow-[0_1px_2px_rgb(0_0_0/0.08)]' : 'text-neutral-500']}>
          <img src={logo} alt="" class="size-3 object-contain" />{engine}
        </span>
      ))}
    </span>
    <span class="inline-flex items-center gap-1 rounded-md border border-neutral-200 px-2 py-1 text-[10.5px] text-neutral-600">Last 28 days <ChevronDown className="size-3" /></span>
    <!-- One button: Add to Ideas, counting the picks, then the result in green. -->
    <span class="[&.on>span]:!bg-emerald-600" data-at={addAt + 1} data-fx="state">
      <span data-cursor-at={addAt} data-at={firstPick} data-fx="state" class="[&.on>[data-base]]:hidden inline-flex items-center gap-1 rounded-md bg-neutral-900 px-2.5 py-1 text-[10.5px] font-medium text-white transition-colors">
        <span data-base>Add to Ideas</span>
        {picks.map((_, index) => (
          <span data-at={firstPick + index} data-until={index === picks.length - 1 ? addAt + 1 : firstPick + index + 1} data-fx="collapse">Add {index + 1} to Ideas</span>
        ))}
        <span class="inline-flex items-center gap-1" data-at={addAt + 1} data-fx="collapse"><Check className="size-3" /> {picks.length} ideas added</span>
      </span>
    </span>
  </div>
  <div class="flex items-center gap-1.5 px-4 pt-2.5 text-[10.5px]">
    {SEO_OPPORTUNITY_FILTERS.map(([label, count], index) => (
      <span class:list={['inline-flex items-center gap-1 rounded-full border px-2 py-0.5', index === 0 ? 'border-neutral-900 bg-neutral-900 text-white' : 'border-neutral-200 text-neutral-600']}>
        {label} <span class="text-neutral-400">{count}</span>
      </span>
    ))}
    <span class="ml-auto inline-flex w-40 items-center gap-1.5 rounded-md border border-neutral-200 px-2 py-1 text-neutral-400"><Search className="size-3" /> Filter</span>
  </div>
  <div class="flex-1 overflow-hidden px-4 pt-2">
    <div class:list={[columns, 'border-b border-neutral-200 py-1.5 text-[9.5px] font-medium uppercase tracking-wide text-neutral-400']}>
      <span class="size-3 rounded-[3px] border border-neutral-300"></span>
      <span>What people searched</span><span>Problem</span><span class="text-right">Position</span><span class="text-right">Impressions</span><span class="text-right">Clicks</span>
    </div>
    {SEO_OPPORTUNITIES.map((group) => (
      <div>
        <div class="flex items-baseline gap-2 pb-1 pt-2.5 text-[11px]">
          <span class="font-medium text-neutral-900">{group.page}</span>
          {group.path && <span class="font-mono text-[10px] text-neutral-400">{group.path}</span>}
        </div>
        {group.rows.map((row) => {
          const pick = picks.indexOf(row.query)
          return (
            <div class:list={[columns, 'border-b border-neutral-100 py-1.5']}>
              {pick === -1
                ? <span class="size-3 rounded-[3px] border border-neutral-300"></span>
                : (
                  <span class="group/cb grid size-3 place-items-center rounded-[3px] border border-neutral-300 [&.on]:border-neutral-900 [&.on]:bg-neutral-900" data-at={firstPick + pick} data-fx="state" data-cursor-at={firstPick + pick - 1}>
                    <Check className="size-2.5 text-white opacity-0 group-[.on]/cb:opacity-100" strokeWidth={3} />
                  </span>
                )}
              <span class:list={['truncate', row.query === 'The whole page' ? 'italic text-neutral-500' : 'text-neutral-800']}>{row.query}</span>
              <span><span class:list={['rounded px-1.5 py-0.5 text-[10px] font-medium', problemTone[row.problem]]}>{row.problem}</span></span>
              <span class="text-right tabular-nums text-neutral-600">{row.position}</span>
              <span class="text-right tabular-nums text-neutral-900">{row.impressions}</span>
              <span class="text-right tabular-nums text-neutral-600">{row.clicks}</span>
            </div>
          )
        })}
      </div>
    ))}
  </div>
  <Cursor />
</div>
