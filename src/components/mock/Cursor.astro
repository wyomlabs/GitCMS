---
// Pointer that the Sequencer glides between `data-cursor-at` targets.
// Rounded arrow (Lucide's mouse-pointer-2), filled black with a thin white
// outline so it reads on light pages and dark buttons. The SVG is nudged so
// the arrow's tip, not its box corner, sits on the click point.
---
<span data-cursor aria-hidden="true">
  <span class="ring absolute -left-2.5 -top-2.5 block size-6 rounded-full bg-neutral-900/30"></span>
  <svg width="22" height="22" viewBox="0 0 24 24" class="relative -left-[4px] -top-[4px] drop-shadow-[0_1px_1.5px_rgba(0,0,0,0.25)]">
    <path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z" fill="#0a0a0a" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</span>
