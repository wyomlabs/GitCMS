---
// A prompt-library entry as a card: the whole card opens the prompt page,
// and the Copy button copies the prompt without leaving.
import type { CollectionEntry } from 'astro:content'
import CopyButton from '@/components/site/CopyButton.astro'
import { card } from '@/components/site/styles'
import { promptText } from '@/lib/prompt-text'

interface Props {
  prompt: CollectionEntry<'prompts'>
}
const { prompt } = Astro.props
const slug = prompt.id.replace(/\.mdx?$/, '')
const text = promptText(prompt.body)
---
<div class:list={['relative flex flex-col p-6 text-left transition-colors hover:border-neutral-300', card]}>
  <h3 class="pr-24 text-[18px] font-semibold tracking-[-0.02em] text-neutral-900">
    <a href={`/prompts/${slug}`} class="after:absolute after:inset-0">{prompt.data.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-[14.5px] leading-relaxed text-[#898989]">{prompt.data.description}</p>
  <p class="mt-4 text-[12px] text-neutral-500">{prompt.data.agents.join(' · ')}</p>
  {text && <CopyButton size="sm" text={text} label="Copy" class="absolute right-5 top-5 z-10" />}
</div>
