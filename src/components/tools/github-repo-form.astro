---
import { appUrl } from '@/lib/start-login'
---
<form
  data-github-repo-form
  data-app-url={appUrl('/')}
  class="rounded-2xl border border-neutral-200 bg-white p-6"
>
  <label for="github-repo-input" class="text-sm font-medium text-neutral-900">Public GitHub repository</label>
  <div class="mt-3 flex flex-col gap-3 sm:flex-row">
    <input
      id="github-repo-input"
      name="repository"
      required
      autocomplete="off"
      spellcheck="false"
      placeholder="owner/repo or https://github.com/owner/repo/blob/main/README.md"
      class="h-11 flex-1 rounded-lg border border-neutral-300 px-3 font-mono text-sm text-neutral-900 outline-none focus:border-neutral-900"
    />
    <button type="submit" class="h-11 rounded-lg bg-neutral-900 px-5 text-sm font-medium text-white transition-colors hover:bg-neutral-700">
      Open in editor
    </button>
  </div>
  <p data-github-repo-error class="mt-2 hidden text-sm text-red-600">Enter a GitHub repository, such as vercel/next.js, or a GitHub URL.</p>
  <p class="mt-3 text-sm text-neutral-500">
    Try <button type="button" data-github-repo-example class="font-mono text-neutral-700 underline underline-offset-2">vercel/next.js</button>
  </p>
</form>

<script>
  // The app's repo viewer mirrors GitHub's paths (`/owner/repo/blob/...`), so
  // a GitHub URL only needs its origin swapped.
  function repoViewerPath(input: string) {
    const path = input
      .trim()
      .replace(/^https?:\/\//, '')
      .replace(/^(www\.)?github\.com\//, '')
    const segments = path.split(/[?#]/)[0]?.split('/').filter(Boolean) ?? []
    const [owner, repo, ...rest] = segments
    if (!owner || !repo || owner.includes('.')) return null
    return [owner, repo.replace(/\.git$/, ''), ...rest].join('/')
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-github-repo-form]')) {
    const input = form.querySelector('input')
    const error = form.querySelector('[data-github-repo-error]')
    form.querySelector('[data-github-repo-example]')?.addEventListener('click', () => {
      if (input) input.value = 'vercel/next.js'
    })
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const path = repoViewerPath(input?.value ?? '')
      error?.classList.toggle('hidden', path !== null)
      if (path) window.location.assign(new URL(path, form.dataset.appUrl))
    })
  }
</script>
