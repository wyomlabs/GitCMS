---
import BaseLayout from './BaseLayout.astro'
import ContentHeader from '@/components/content-header.astro'
import { DiscordSupportButton } from '@/components/landing/discord-support-button'
import { LandingFooter } from '@/components/landing/landing-footer'
import type { SeoOptions } from '@/lib/seo'

interface Props extends SeoOptions {
  structuredData?: unknown
}
---
<BaseLayout {...Astro.props}>
  <div class="flex min-h-screen flex-col bg-white text-neutral-900">
    <ContentHeader />
    <main class="flex-1"><slot /></main>
    <LandingFooter />
    <DiscordSupportButton />
  </div>
</BaseLayout>
