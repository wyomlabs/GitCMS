---
// Every marketing and content page (not docs): grey page background, the
// floating header, a bordered 1200px column holding the page's sections, the
// footer inside that column, and the floating Discord support button. Pages
// compose Section and SectionHeading.
import '@/styles/global.css'
import BaseLayout from './BaseLayout.astro'
import SiteNav from '@/components/site/SiteNav.astro'
import SiteFooter from '@/components/site/SiteFooter.astro'
import Sequencer from '@/components/site/Sequencer.astro'
import DiscordSupportButton from '@/components/site/DiscordSupportButton.astro'
import type { SeoOptions } from '@/lib/seo'

interface Props extends SeoOptions {
  structuredData?: unknown
}
---
<BaseLayout {...Astro.props}>
  <div class="min-h-screen bg-[#f4f4f4] text-neutral-900">
    <SiteNav />
    <!-- The fixed header floats over this column; the top padding clears it. -->
    <div class="mx-auto max-w-[1200px] border-x border-neutral-200 pt-[88px]">
      <main><slot /></main>
      <SiteFooter />
    </div>
  </div>
  <DiscordSupportButton />
  <Sequencer />
</BaseLayout>

<style>
  /* Anchor jumps land below the fixed header. */
  :global(html) { scroll-padding-top: 88px; }
</style>
