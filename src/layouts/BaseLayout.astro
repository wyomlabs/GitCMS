---
// Document shell only. Each layout imports its Tailwind entry: global.css for
// marketing pages, docs.css for /docs.
import MdxCopyButtons from '@/components/mdx/MdxCopyButtons.astro'
import { getSeo, type SeoOptions } from '@/lib/seo'
import { PRODUCT_DEFINITION, PRODUCT_NAME, SITE_URL } from '@/lib/positioning'
import { absolutePublicUrl, markdownPathForHtmlPath } from '@/lib/public-resources'
import { SITE_REPOSITORY_URL } from '@/lib/support-links'

interface Props extends SeoOptions {
  structuredData?: unknown
}

const seo = getSeo(Astro.props)
const { structuredData } = Astro.props
const markdownAlternate = absolutePublicUrl(markdownPathForHtmlPath(Astro.props.path ?? '/'))
const llmsIndex = absolutePublicUrl('/llms.txt')
const siteStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: PRODUCT_NAME,
    url: SITE_URL,
    logo: `${SITE_URL}/logo512.png`,
    description: PRODUCT_DEFINITION,
    sameAs: [
      'https://x.com/gitcms_app',
      SITE_REPOSITORY_URL,
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: PRODUCT_NAME,
    url: SITE_URL,
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#DCF986" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    <link rel="describedby" type="text/plain" href={llmsIndex} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:secure_url" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={seo.twitterHandle} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:url" content={seo.canonical} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.authors.map((author) => <meta property="article:author" content={author} />)}
    {seo.noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/gitcms-logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {siteStructuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="a8229929-c431-4b01-85b5-61675a78dc24"></script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <slot />
    <MdxCopyButtons />
  </body>
</html>
